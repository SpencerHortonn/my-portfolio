---
// Dark quote interlude — sits between Work and Switzerland
---

<section class="quote-interlude relative overflow-hidden" aria-label="Quote">

  <!-- Gradient fades: warm beige → dark at top, dark → warm beige at bottom -->
  <div class="absolute inset-x-0 top-0 h-40 pointer-events-none z-10"
       style="background: linear-gradient(to bottom, #E5DCC8, #1F1B16);"
       aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-40 pointer-events-none z-10"
       style="background: linear-gradient(to top, #E5DCC8, #1F1B16);"
       aria-hidden="true"></div>

  <!-- Film frame numbers — vertical type, desktop only -->
  <div class="absolute left-6 top-1/2 -translate-y-1/2 hidden lg:block pointer-events-none" aria-hidden="true">
    <span class="font-sans text-[9px] tracking-[0.2em] uppercase text-white/20"
          style="writing-mode: vertical-rl; transform: rotate(180deg); display: block;">
      023 &rsaquo; 024 &nbsp; TYLER TX
    </span>
  </div>
  <div class="absolute right-6 top-1/2 -translate-y-1/2 hidden lg:block pointer-events-none" aria-hidden="true">
    <span class="font-sans text-[9px] tracking-[0.2em] uppercase text-white/20"
          style="writing-mode: vertical-rl; display: block;">
      2026 &mdash; KODAK 400
    </span>
  </div>

  <!-- Quote -->
  <div class="relative z-20 py-40 md:py-56 max-w-3xl mx-auto px-6 text-center">
    <p
      class="font-serif italic font-light text-white leading-tight reveal"
      style="font-size: clamp(1.9rem, 4.5vw, 3.2rem);"
    >
      &ldquo;Rather be broke<br />and happy than<br />rich and bored.&rdquo;
    </p>
    <p class="font-sans text-[10px] tracking-[0.25em] uppercase text-white/25 mt-10 reveal reveal-d1">
      — going anyway
    </p>
  </div>

</section>

<style>
  .quote-interlude {
    background-color: #1F1B16;
  }
</style>
