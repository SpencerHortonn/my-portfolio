---
interface ClientLogo {
  name: string;
  logo: string;
  slug: string;
}
interface Props {
  clients: ClientLogo[];
}
const { clients } = Astro.props;
---

{clients.length > 0 && (
  <section class="py-14 md:py-20 border-b border-f-border/40" aria-label="Past clients">
    <div class="max-w-6xl mx-auto px-6">
      <p class="font-sans text-xs tracking-[0.25em] uppercase text-f-gray mb-8 text-center reveal">
        Past clients
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-14 gap-y-10 reveal reveal-d1">
        {clients.map(client => (
          <a href={`/portfolio/${client.slug}`} aria-label={`View case study: ${client.name}`}>
            <img
              src={client.logo}
              alt={client.name}
              title={client.name}
              class="h-12 md:h-16 object-contain opacity-70 hover:opacity-100 transition-opacity"
              loading="lazy"
            />
          </a>
        ))}
      </div>
    </div>
  </section>
)}
