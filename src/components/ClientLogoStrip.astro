---
interface ClientLogo {
  name: string;
  logo: string;
}
interface Props {
  clients: ClientLogo[];
}
const { clients } = Astro.props;
---

{clients.length > 0 && (
  <section class="py-14 md:py-20 border-b border-f-border/40" aria-label="Past clients">
    <div class="max-w-6xl mx-auto px-6">
      <p class="font-sans text-xs tracking-[0.25em] uppercase text-f-gray mb-8 text-center reveal">
        Past clients
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-8 reveal reveal-d1">
        {clients.map(client => (
          <img
            src={client.logo}
            alt={client.name}
            title={client.name}
            class="h-8 md:h-10 object-contain opacity-60 hover:opacity-100 transition-opacity grayscale hover:grayscale-0"
            loading="lazy"
          />
        ))}
      </div>
    </div>
  </section>
)}
