---
import type { PortfolioItem } from '../lib/db';
interface Props {
  items: PortfolioItem[];
}
const { items } = Astro.props;

function mediaLabel(item: PortfolioItem): string {
  const hasVideo = Boolean(item.video_file || item.embed_url);
  const hasPhotos = item.images.length > 0;
  if (hasVideo && hasPhotos) return 'Film + Photos';
  if (hasVideo) return 'Film';
  if (hasPhotos) return 'Photos';
  return 'Photo';
}
---

<div class="grid grid-cols-2 md:grid-cols-3">
  {items.map(item => (
    <a
      href={`/portfolio/${item.slug}`}
      class="group relative block aspect-square overflow-hidden bg-f-paper-warm"
      aria-label={`View case study: ${item.client_name || 'Personal project'} — ${item.title}`}
    >
      <img
        src={item.thumbnail}
        alt={item.title}
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        loading="lazy"
      />
      <div
        class="absolute inset-x-0 bottom-0 px-4 py-3 md:px-5 md:py-4"
        style="background: linear-gradient(to top, rgba(10,9,7,0.75) 0%, rgba(10,9,7,0.25) 70%, transparent 100%);"
      >
        <p class="font-sans text-xs md:text-sm tracking-[0.1em] uppercase text-white">
          {item.client_name || 'Personal'}
        </p>
        <p class="font-sans text-[10px] md:text-xs tracking-[0.15em] uppercase text-white/60 mt-0.5">
          {mediaLabel(item)}
        </p>
      </div>
    </a>
  ))}
</div>
