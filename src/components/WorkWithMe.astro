---
interface Service { title: string; desc: string; }
interface Props {
  intro: string;
  services: Service[];
  email: string;
  phone: string;
  phoneTel: string;
}
const { intro, services, email, phone, phoneTel } = Astro.props;
---

<section id="work-with-me" class="py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Header -->
    <div class="max-w-2xl mb-16 reveal">
      <p class="font-sans text-xs tracking-[0.25em] uppercase text-f-gray mb-5">
        Work with me
      </p>
      <h2 class="font-serif text-4xl md:text-5xl font-light text-f-ink leading-tight mb-8">
        For brands that<br />
        actually believe<br />
        in something.
      </h2>
      <p class="font-sans text-base md:text-[17px] text-f-gray font-light leading-relaxed">
        {intro}
      </p>
    </div>

    <!-- Services — grid with hairline borders -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-f-border mb-20 reveal reveal-d1">
      {services.map(service => (
        <div class="bg-f-white p-8 md:p-10">
          <h3 class="font-serif text-xl text-f-ink mb-3">{service.title}</h3>
          <p class="font-sans text-sm text-f-gray font-light leading-relaxed">{service.desc}</p>
        </div>
      ))}
    </div>

    <!-- Pricing note + direct contact -->
    <div class="flex flex-col gap-5 mb-20 reveal reveal-d2">
      <p class="font-sans text-sm text-f-gray font-light">
        Pricing is quoted per project — <a href={`mailto:${email}`} class="underline underline-offset-2 hover:text-f-ink transition-colors">contact me</a> for personalized pricing.
      </p>
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-8 font-sans text-sm text-f-gray">
        <a href={`mailto:${email}`} class="hover:text-f-ink transition-colors">{email}</a>
        <a href={phoneTel} class="hover:text-f-ink transition-colors">{phone}</a>
      </div>
    </div>

    <!-- Contact form -->
    <div class="max-w-xl reveal reveal-d3">
      <p class="font-sans text-xs tracking-[0.25em] uppercase text-f-gray mb-6">Or send a message</p>
      <form id="contact-form" class="flex flex-col gap-4" novalidate>
        <div>
          <label for="contact-name" class="sr-only">Your name</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            placeholder="Your name"
            required
            class="w-full px-4 py-3 bg-f-white border border-f-border text-f-ink font-sans text-sm placeholder:text-f-gray/50 focus:outline-none focus:border-f-ink transition-colors"
          />
        </div>
        <div>
          <label for="contact-email" class="sr-only">Your email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            placeholder="your@email.com"
            required
            class="w-full px-4 py-3 bg-f-white border border-f-border text-f-ink font-sans text-sm placeholder:text-f-gray/50 focus:outline-none focus:border-f-ink transition-colors"
          />
        </div>
        <div>
          <label for="contact-message" class="sr-only">Your message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            placeholder="Tell me about your project..."
            required
            class="w-full px-4 py-3 bg-f-white border border-f-border text-f-ink font-sans text-sm placeholder:text-f-gray/50 focus:outline-none focus:border-f-ink transition-colors"
          ></textarea>
        </div>
        <button
          type="submit"
          class="self-start px-8 py-4 bg-f-ink text-f-white font-sans text-xs tracking-[0.15em] uppercase hover:bg-f-ink/80 transition-colors"
        >
          Send message
        </button>
      </form>
      <p id="contact-error" class="hidden mt-4 font-sans text-sm text-red-800">
        Something went wrong — try again, or email me directly.
      </p>
      <div id="contact-success" class="hidden mt-4 font-sans text-sm text-f-ink">
        Got it — I'll get back to you soon.
      </div>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = {
      name: (form.querySelector('#contact-name') as HTMLInputElement)?.value || '',
      email: (form.querySelector('#contact-email') as HTMLInputElement)?.value || '',
      message: (form.querySelector('#contact-message') as HTMLTextAreaElement)?.value || '',
    };
    const errorEl = document.getElementById('contact-error');
    const successEl = document.getElementById('contact-success');
    errorEl?.classList.add('hidden');
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        form.style.display = 'none';
        successEl?.classList.remove('hidden');
      } else {
        errorEl?.classList.remove('hidden');
      }
    } catch (_) {
      errorEl?.classList.remove('hidden');
    }
  });
</script>
