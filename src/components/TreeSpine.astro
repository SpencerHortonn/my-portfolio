<style>
  /* ══ Containers ══ */
  .tree-desktop {
    display: none;
    position: fixed;
    left: 6px;
    top: 72px;
    width: 170px;
    height: calc(100vh - 72px - 28px);
    pointer-events: none;
    z-index: 20;
  }
  @media (min-width: 1024px) { .tree-desktop { display: block; } }
  .tree-svg { width: 100%; height: 100%; display: block; overflow: visible; }

  /* ── Sprout: CSS animations triggered by .sprouting class ── */
  .tree-desktop.sprouting #trunk-a {
    animation: draw-in 1.0s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }
  .tree-desktop.sprouting #trunk-b {
    animation: draw-in 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.7s forwards;
  }
  .tree-desktop.sprouting #trunk-c {
    animation: draw-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) 1.3s forwards;
  }
  .tree-desktop.sprouting #trunk-bark {
    animation: draw-in 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
  }

  /* Roots draw in with base trunk */
  .tree-desktop.sprouting .root-line.r1 { animation: draw-in 0.8s ease 1.2s forwards; }
  .tree-desktop.sprouting .root-line.r2 { animation: draw-in 0.7s ease 1.5s forwards; }
  .tree-desktop.sprouting .root-line.r3 { animation: draw-in 0.6s ease 1.8s forwards; }

  /* Twig nubs */
  .twig-nub { opacity: 0; }
  .tree-desktop.sprouting .twig-nub:nth-child(1) { animation: nub-in 0.4s ease 0.6s forwards; }
  .tree-desktop.sprouting .twig-nub:nth-child(2) { animation: nub-in 0.4s ease 1.0s forwards; }
  .tree-desktop.sprouting .twig-nub:nth-child(3) { animation: nub-in 0.4s ease 1.4s forwards; }
  .tree-desktop.sprouting .twig-nub:nth-child(4) { animation: nub-in 0.4s ease 1.8s forwards; }

  /* ── Branch draw-in ── */
  .branch-line-main {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    stroke-width: 2px;
    transition: stroke-width 0.6s ease;
  }
  .branch-line-sub {
    stroke-dasharray: 130;
    stroke-dashoffset: 130;
  }
  .tree-desktop.sprouting #branch-work-with-me .branch-line-main {
    animation: draw-in 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;
  }
  .tree-desktop.sprouting #branch-work-with-me .branch-line-sub:not(.lush-sub) {
    animation: draw-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) 1.2s forwards;
  }
  .tree-desktop.sprouting #branch-switzerland .branch-line-main {
    animation: draw-in 0.62s cubic-bezier(0.16, 1, 0.3, 1) 1.1s forwards;
  }
  .tree-desktop.sprouting #branch-switzerland .branch-line-sub:not(.lush-sub) {
    animation: draw-in 0.48s cubic-bezier(0.16, 1, 0.3, 1) 1.5s forwards;
  }
  .tree-desktop.sprouting #branch-work .branch-line-main {
    animation: draw-in 0.60s cubic-bezier(0.16, 1, 0.3, 1) 1.4s forwards;
  }
  .tree-desktop.sprouting #branch-work .branch-line-sub:not(.lush-sub) {
    animation: draw-in 0.46s cubic-bezier(0.16, 1, 0.3, 1) 1.8s forwards;
  }
  .tree-desktop.sprouting #branch-about .branch-line-main {
    animation: draw-in 0.58s cubic-bezier(0.16, 1, 0.3, 1) 1.7s forwards;
  }
  .tree-desktop.sprouting #branch-about .branch-line-sub {
    animation: draw-in 0.44s cubic-bezier(0.16, 1, 0.3, 1) 2.1s forwards;
  }

  @keyframes draw-in { to { stroke-dashoffset: 0; } }
  @keyframes nub-in  { to { opacity: 0.55; } }

  /* ── Extra branches (wave-revealed) ── */
  .extra-branch {
    stroke-dasharray: 80;
    stroke-dashoffset: 80;
  }
  .tree-desktop.wave-1 .extra-branch.w1.s2 { animation: draw-in 0.6s ease 0.1s forwards; }
  .tree-desktop.wave-1 .extra-branch.w1.s4 { animation: draw-in 0.6s ease 0.32s forwards; }
  .tree-desktop.wave-1 .extra-branch.w1.s6 { animation: draw-in 0.6s ease 0.55s forwards; }
  .tree-desktop.wave-1 .extra-branch.w1.s8 { animation: draw-in 0.6s ease 0.76s forwards; }
  .tree-desktop.wave-2 .extra-branch.w2.s2 { animation: draw-in 0.55s ease 0.1s forwards; }
  .tree-desktop.wave-2 .extra-branch.w2.s5 { animation: draw-in 0.55s ease 0.36s forwards; }
  .tree-desktop.wave-3 .extra-branch.w3.s3 { animation: draw-in 0.5s ease 0.2s forwards; }
  .tree-desktop.wave-4 .extra-branch.w4.s1 { animation: draw-in 0.45s ease 0.1s forwards; }

  /* ── Lush sub-branches ── */
  /* JS sets actual dasharray/dashoffset via getTotalLength */
  .tree-desktop.wave-2 #branch-work .lush-sub.ls1 {
    animation: draw-in 0.55s ease 0.2s forwards;
  }
  .tree-desktop.wave-2 #branch-work .lush-sub.ls2 {
    animation: draw-in 0.5s ease 0.45s forwards;
  }
  .tree-desktop.wave-3 #branch-switzerland .lush-sub.ls1 {
    animation: draw-in 0.55s ease 0.25s forwards;
  }
  .tree-desktop.wave-4 #branch-work-with-me .lush-sub.ls1 {
    animation: draw-in 0.55s ease 0.1s forwards;
  }
  .tree-desktop.wave-4 #branch-work-with-me .lush-sub.ls2 {
    animation: draw-in 0.5s ease 0.35s forwards;
  }

  /* ── Canopy branches ── */
  .cbd1 { --cbd: 0ms;   } .cbd2 { --cbd: 200ms; } .cbd3 { --cbd: 400ms; }
  .cbd4 { --cbd: 140ms; } .cbd5 { --cbd: 340ms; }

  .tree-desktop.wave-3 .canopy-branch.cb-w3 {
    animation: draw-in 0.75s cubic-bezier(0.16, 1, 0.3, 1) var(--cbd) forwards;
  }
  .tree-desktop.wave-4 .canopy-branch.cb-w4 {
    animation: draw-in 0.65s cubic-bezier(0.16, 1, 0.3, 1) var(--cbd) forwards;
  }

  /* ── Branch blossoms (in-branch flowers) ── */
  .branch-blossom {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
    opacity: 0;
  }
  .tree-desktop.wave-3 #branch-switzerland .branch-blossom {
    animation: blossom-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) var(--bd) forwards;
  }
  .tree-desktop.wave-4 #branch-work-with-me .branch-blossom {
    animation: blossom-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) var(--bd) forwards;
  }

  /* ── Leaves ── */
  .leaf-scale {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.2);
    opacity: 0.1;
    transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.7s ease-out;
  }
  .leaf-scale.bloomed     { transform: scale(1.0); opacity: 1; }
  .leaf-scale.active-leaf { transform: scale(1.2) !important; }

  /* ── Active branch ── */
  .branch-group.active-branch .branch-line-main { stroke-width: 4px; }
  .branch-group.active-branch .branch-line-sub  { stroke-width: 2px; }

  /* ── Blossoms ── */
  .blossom {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
    opacity: 0;
  }
  @keyframes blossom-pop {
    0%   { transform: scale(0);    opacity: 0; }
    60%  { transform: scale(1.25); opacity: 1; }
    100% { transform: scale(1);    opacity: 1; }
  }
  .blossom.s1 { --bd: 0ms;   } .blossom.s2 { --bd: 90ms;  }
  .blossom.s3 { --bd: 180ms; } .blossom.s4 { --bd: 270ms; }
  .blossom.s5 { --bd: 360ms; } .blossom.s6 { --bd: 450ms; }
  .blossom.s7 { --bd: 540ms; } .blossom.s8 { --bd: 630ms; }
  .blossom.bl-lg { --bs: 1.0; } .blossom.bl-md { --bs: 0.85; } .blossom.bl-sm { --bs: 0.70; }
  .blossom       { --bs: 0.80; }

  .tree-desktop.wave-1 .blossom.w1 { animation: blossom-pop 0.55s cubic-bezier(0.34,1.56,0.64,1) var(--bd) forwards; }
  .tree-desktop.wave-2 .blossom.w2 { animation: blossom-pop 0.55s cubic-bezier(0.34,1.56,0.64,1) var(--bd) forwards; }
  .tree-desktop.wave-3 .blossom.w3 { animation: blossom-pop 0.55s cubic-bezier(0.34,1.56,0.64,1) var(--bd) forwards; }
  .tree-desktop.wave-4 .blossom.w4 { animation: blossom-pop 0.55s cubic-bezier(0.34,1.56,0.64,1) var(--bd) forwards; }

  /* ── Ground scene ── */
  .grass-blade {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  @keyframes grass-grow {
    from { opacity: 0; transform: scaleY(0.25); }
    to   { opacity: 0.65; transform: scaleY(1); }
  }
  .tree-desktop.wave-3 .grass-blade.gw3 {
    animation: grass-grow 500ms ease-out var(--gd) forwards;
  }
  .tree-desktop.wave-4 .grass-blade.gw4 {
    animation: grass-grow 500ms ease-out var(--gd) forwards;
  }

  .ground-flower, .fallen-leaf {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.5);
    opacity: 0;
  }
  @keyframes ground-pop {
    from { transform: scale(0.5); opacity: 0; }
    to   { transform: scale(1);   opacity: 1; }
  }
  .tree-desktop.wave-3 .ground-flower.gw3 { animation: ground-pop 500ms ease-out var(--gd) forwards; }
  .tree-desktop.wave-4 .ground-flower.gw4 { animation: ground-pop 500ms ease-out var(--gd) forwards; }
  .tree-desktop.wave-3 .fallen-leaf.gw3   { animation: ground-pop 500ms ease-out var(--gd) forwards; }
  .tree-desktop.wave-4 .fallen-leaf.gw4   { animation: ground-pop 500ms ease-out var(--gd) forwards; }

  /* ── Labels ── */
  .tree-label {
    position: absolute;
    left: 128px;
    font-family: 'Caveat', cursive;
    font-size: 13.5px;
    color: #5C5840;
    opacity: 0.28;
    pointer-events: all;
    text-decoration: none;
    white-space: nowrap;
    transform: translateY(-50%);
    transition: opacity 0.5s ease, color 0.4s ease;
    display: none;
  }
  @media (min-width: 1440px) { .tree-label { display: block; } }
  .tree-label.label-bloomed { opacity: 0.8;  color: #2B2825; }
  .tree-label.label-active  { opacity: 1;    color: #1F1C18; }
  .tree-label:hover { opacity: 1 !important; color: #1F1C18 !important; }

  /* ══ Mobile vine ══ */
  .tree-mobile {
    display: block;
    position: fixed;
    right: 6px;
    top: 72px;
    width: 18px;
    height: calc(100vh - 72px - 28px);
    pointer-events: none;
    z-index: 20;
  }
  @media (min-width: 1024px) { .tree-mobile { display: none; } }

  #mobile-vine { stroke-dasharray: 1400; stroke-dashoffset: 1400; }
  .tree-mobile.sprouting #mobile-vine {
    animation: draw-in 2.0s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }

  .mobile-dot { opacity: 0.28; transition: opacity 0.4s ease; }
  .mobile-dot .dot-fill { opacity: 0; transition: opacity 0.4s ease, transform 0.4s ease; transform-box: fill-box; transform-origin: center; }
  .mobile-dot.bloomed { opacity: 1; }
  .mobile-dot.bloomed .dot-fill { opacity: 1; }
  .mobile-dot.active-dot .dot-fill { transform: scale(2); }

  .mobile-blossom { transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.34,1.56,0.64,1); transform-box: fill-box; transform-origin: center; transform: scale(0); }
  .tree-mobile.wave-1 .mb-w1 { opacity: 0.8 !important; transform: scale(1) !important; }
  .tree-mobile.wave-2 .mb-w2 { opacity: 0.7 !important; transform: scale(1) !important; }
  .tree-mobile.wave-3 .mb-w3 { opacity: 0.6 !important; transform: scale(1) !important; }
  .tree-mobile.wave-4 .mb-w4 { opacity: 0.5 !important; transform: scale(1) !important; }

  /* Mobile ground elements */
  .mob-ground {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.5);
    opacity: 0;
  }
  .tree-mobile.wave-3 .mob-ground.gw3 { animation: ground-pop 500ms ease-out var(--mgd) forwards; }
  .tree-mobile.wave-4 .mob-ground.gw4 { animation: ground-pop 500ms ease-out var(--mgd) forwards; }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    #trunk-a, #trunk-b, #trunk-c, #trunk-bark, #mobile-vine,
    .branch-line-main, .branch-line-sub, .extra-branch, .root-line,
    .canopy-branch, .lush-sub {
      stroke-dashoffset: 0 !important;
      animation: none !important;
    }
    .blossom, .branch-blossom { animation: none !important; opacity: 0.7; transform: scale(0.9); }
    .twig-nub { opacity: 0.55; animation: none !important; }
    .leaf-scale { transform: scale(1); opacity: 0.3; transition: none; }
    .leaf-scale.bloomed { opacity: 1; }
    .grass-blade { opacity: 0.6; transform: scaleY(1); animation: none !important; }
    .ground-flower, .fallen-leaf, .mob-ground { opacity: 1; transform: scale(1); animation: none !important; }
  }
</style>


<script>
  type SectionId = 'about' | 'work' | 'switzerland' | 'work-with-me';
  const sectionIds: SectionId[] = ['about', 'work', 'switzerland', 'work-with-me'];

  const treeEl     = document.getElementById('tree-spine');
  const treeMobile = document.getElementById('tree-mobile');
  const trunkA     = document.getElementById('trunk-a')    as SVGPathElement | null;
  const trunkB     = document.getElementById('trunk-b')    as SVGPathElement | null;
  const trunkC     = document.getElementById('trunk-c')    as SVGPathElement | null;
  const trunkBark  = document.getElementById('trunk-bark') as SVGPathElement | null;
  const mobileVine = document.getElementById('mobile-vine') as SVGPathElement | null;

  function initDasharrays() {
    const setDA = (el: SVGPathElement | null) => {
      if (!el) return;
      const len = el.getTotalLength();
      el.style.strokeDasharray  = `${len}`;
      el.style.strokeDashoffset = `${len}`;
    };
    setDA(trunkA); setDA(trunkB); setDA(trunkC); setDA(trunkBark); setDA(mobileVine);

    document.querySelectorAll<SVGPathElement>(
      '.branch-line-main, .branch-line-sub, .extra-branch, .lush-sub, .root-line, .canopy-branch'
    ).forEach(p => {
      const l = p.getTotalLength();
      p.style.strokeDasharray  = `${l}`;
      p.style.strokeDashoffset = `${l}`;
    });
  }

  // ── Sprout ──
  let sproutDone = false;

  function startSprout() {
    if (sproutDone) return;
    sproutDone = true;

    if (treeEl)     { treeEl.style.transition     = 'opacity 0.4s ease'; treeEl.style.opacity     = '1'; }
    if (treeMobile) { treeMobile.style.transition  = 'opacity 0.4s ease'; treeMobile.style.opacity = '1'; }

    treeEl?.classList.add('sprouting');
    treeMobile?.classList.add('sprouting');

    // Base leaves bloom in sequence matching CSS animation delays
    const branchLeafDelays: Record<string, number> = {
      'branch-work-with-me': 1500,
      'branch-switzerland':  2000,
      'branch-work':         2300,
      'branch-about':        2600,
    };
    Object.entries(branchLeafDelays).forEach(([branchId, baseDelay]) => {
      const branch = document.getElementById(branchId);
      // Only bloom base leaves (not lush-leaf)
      branch?.querySelectorAll<HTMLElement>('.leaf-scale:not(.lush-leaf):not(.canopy-leaf-w3):not(.canopy-leaf-w4)')
        .forEach((leaf, i) => {
          setTimeout(() => leaf.classList.add('bloomed'), baseDelay + i * 90);
        });
    });
  }

  // ── Lush leaf blooming ──
  let lushWorkBloomed    = false;
  let lushSwissBloomed   = false;
  let lushWwmBloomed     = false;
  let canopyW3Bloomed    = false;
  let canopyW4Bloomed    = false;

  function bloomLeaves(selector: string, baseDelay = 0) {
    document.querySelectorAll<HTMLElement>(selector).forEach((leaf, i) => {
      setTimeout(() => leaf.classList.add('bloomed'), baseDelay + i * 90);
    });
  }

  // ── Scroll-driven waves ──
  let waveState = 0;

  function updateBlossoms() {
    const scrollY = window.scrollY;
    const heroH   = document.getElementById('hero')?.offsetHeight ?? window.innerHeight;
    const pageH   = document.documentElement.scrollHeight - window.innerHeight;
    const progress = Math.max(0, Math.min(1, (scrollY - heroH) / Math.max(1, pageH - heroH)));

    const newWave = progress > 0.80 ? 4 : progress > 0.55 ? 3 : progress > 0.28 ? 2 : progress > 0.05 ? 1 : 0;
    if (newWave !== waveState) {
      waveState = newWave;
      for (let w = 1; w <= newWave; w++) {
        treeEl?.classList.add(`wave-${w}`);
        treeMobile?.classList.add(`wave-${w}`);
      }

      // Bloom lush leaves per wave
      if (newWave >= 2 && !lushWorkBloomed) {
        lushWorkBloomed = true;
        bloomLeaves('#branch-work .lush-leaf', 400);
      }
      if (newWave >= 3 && !lushSwissBloomed) {
        lushSwissBloomed = true;
        bloomLeaves('#branch-switzerland .lush-leaf', 400);
      }
      if (newWave >= 4 && !lushWwmBloomed) {
        lushWwmBloomed = true;
        bloomLeaves('#branch-work-with-me .lush-leaf', 400);
      }

      // Canopy leaves
      if (newWave >= 3 && !canopyW3Bloomed) {
        canopyW3Bloomed = true;
        bloomLeaves('.canopy-leaf-w3', 700);
      }
      if (newWave >= 4 && !canopyW4Bloomed) {
        canopyW4Bloomed = true;
        bloomLeaves('.canopy-leaf-w4', 600);
      }
    }

    updateActiveSection();
  }

  // ── Active section ──
  let currentActive = '';

  function updateActiveSection() {
    const viewCenter = window.scrollY + window.innerHeight * 0.45;
    let closest = '';
    let closestDist = Infinity;

    sectionIds.forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      const rect = el.getBoundingClientRect();
      const center = window.scrollY + rect.top + rect.height / 2;
      const dist = Math.abs(center - viewCenter);
      if (dist < closestDist) { closestDist = dist; closest = id; }
    });

    const activeEl = document.getElementById(closest);
    if (!activeEl) return;
    const rect = activeEl.getBoundingClientRect();
    const visible = rect.bottom > 50 && rect.top < window.innerHeight - 50;
    const next = visible ? closest : '';

    if (next === currentActive) return;

    if (currentActive) {
      document.getElementById(`branch-${currentActive}`)?.classList.remove('active-branch');
      document.querySelector(`.tree-label[data-label-for="${currentActive}"]`)?.classList.remove('label-active');
      document.getElementById(`mdot-${currentActive}`)?.classList.remove('active-dot');
      document.getElementById(`branch-${currentActive}`)?.querySelectorAll<HTMLElement>('.leaf-scale')
        .forEach(l => l.classList.remove('active-leaf'));
    }

    currentActive = next;

    if (next) {
      document.getElementById(`branch-${next}`)?.classList.add('active-branch');
      document.querySelector(`.tree-label[data-label-for="${next}"]`)?.classList.add('label-active');
      document.getElementById(`mdot-${next}`)?.classList.add('active-dot');
      document.getElementById(`branch-${next}`)?.querySelectorAll<HTMLElement>('.leaf-scale')
        .forEach(l => l.classList.add('active-leaf'));
    }
  }

  // ── IntersectionObserver: bloom labels + mobile dots ──
  const bloomObserver = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const id = e.target.id;
      document.querySelector(`.tree-label[data-label-for="${id}"]`)?.classList.add('label-bloomed');
      document.getElementById(`mdot-${id}`)?.classList.add('bloomed');
    });
  }, { threshold: 0.15 });

  // ── Hero exit observer — triggers sprout ──
  const heroObserver = new IntersectionObserver(entries => {
    entries.forEach(e => { if (!e.isIntersecting) startSprout(); });
  }, { threshold: 0.3 });

  // ── Label smooth-scroll ──
  document.querySelectorAll<HTMLAnchorElement>('.tree-label').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      document.getElementById(a.dataset.labelFor ?? '')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // ── Boot ──
  window.addEventListener('load', () => {
    initDasharrays();

    const hero = document.getElementById('hero');
    if (hero) heroObserver.observe(hero);

    sectionIds.forEach(id => {
      const el = document.getElementById(id);
      if (el) bloomObserver.observe(el);
    });

    window.addEventListener('scroll', () => {
      if (!sproutDone && window.scrollY > (document.getElementById('hero')?.offsetHeight ?? 0) * 0.5) {
        startSprout();
      }
      updateBlossoms();
    }, { passive: true });

    updateBlossoms();
  });
</script>
