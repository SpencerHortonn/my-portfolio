---
// Tree spine navigation — desktop left (≥1024px) + mobile vine right (<1024px)
// Branches illuminate as sections scroll into view (stay lit once visited).
// Click a branch label to smooth-scroll to that section.

const sections = [
  { id: 'about',        label: 'about',        yPct: 20 },
  { id: 'work',         label: 'work',          yPct: 40 },
  { id: 'switzerland',  label: 'switzerland',   yPct: 60 },
  { id: 'work-with-me', label: 'work with me',  yPct: 80 },
];
---

<!-- ══ DESKTOP tree spine — fixed left ══ -->
<div class="tree-desktop" id="tree-spine" aria-label="Page navigation" role="navigation">
  <svg
    class="tree-svg"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- ── Film strip core at trunk center ── -->
    <rect x="20" y="-1" width="9" height="102" fill="#2B2825" opacity="0.45" rx="0.5"/>

    <!-- Sprocket holes punched into the film strip -->
    {[3, 8.5, 14, 19.5, 25, 30.5, 36, 41.5, 47, 52.5, 58, 63.5, 69, 74.5, 80, 85.5, 91, 96.5].map(y => (
      <rect x="21.5" y={y} width="6" height="3.5" rx="1" fill="#E5DCC8" opacity="0.65"/>
    ))}

    <!-- Left vine/bark wrapping the trunk -->
    <path
      d="M20,0 C18.5,8 20.5,18 19,28 C17.5,38 20,48 18.5,58 C17,68 20,78 18.5,88 C17,95 19.5,100 20,100"
      stroke="#5C5840" stroke-width="0.8" fill="none" opacity="0.55" stroke-linecap="round"
    />
    <!-- Right vine/bark -->
    <path
      d="M29,0 C30.5,10 28.5,20 30,30 C31.5,40 29,50 30.5,60 C32,70 29,80 30.5,90 C31.5,97 29.5,100 29,100"
      stroke="#5C5840" stroke-width="0.8" fill="none" opacity="0.55" stroke-linecap="round"
    />

    <!-- Small leaf accents on vine -->
    <g transform="translate(19,15)" opacity="0.4">
      <path d="M0 0 C-3 -5 -8 -3 -6 0 C-8 3 -3 5 0 0Z" fill="#5C5840"/>
    </g>
    <g transform="translate(30,45)" opacity="0.35">
      <path d="M0 0 C3 -5 8 -3 6 0 C8 3 3 5 0 0Z" fill="#5C5840"/>
    </g>
    <g transform="translate(19,72)" opacity="0.32">
      <path d="M0 0 C-3 -5 -8 -3 -6 0 C-8 3 -3 5 0 0Z" fill="#5C5840"/>
    </g>

    <!-- ── Section branches ── -->
    {sections.map(s => (
      <g class="tree-branch" id={`branch-${s.id}`} data-section={s.id}>

        <!-- Branch stem: curves rightward from trunk edge -->
        <path
          class="branch-line"
          d={`M29,${s.yPct} C42,${s.yPct} 54,${s.yPct - 3} 66,${s.yPct - 1.5}`}
          stroke="#5C5840"
          stroke-width="1.1"
          fill="none"
          stroke-linecap="round"
        />

        <!-- Leaf bloom at branch tip -->
        <g class="branch-leaf" transform={`translate(66, ${s.yPct - 1.5})`}>
          <path d="M0 0 C-4 -6 -10 -4 -7 0 C-10 4 -4 6 0 0Z" fill="#5C5840" class="leaf-main"/>
          <path d="M0 0 C3 -5 8 -3 6 0.5 C8 4 3 5.5 0 0Z" fill="#5C5840" opacity="0.6" class="leaf-sec"/>
          <!-- Bloom dot — tiny center -->
          <circle cx="0" cy="0" r="0.8" fill="#7B7A4E" class="leaf-dot"/>
        </g>

      </g>
    ))}
  </svg>

  <!-- Clickable labels — HTML positioned over SVG -->
  {sections.map(s => (
    <a
      href={`#${s.id}`}
      class="tree-label"
      data-label-for={s.id}
      style={`top: calc(${s.yPct}% - 9px)`}
      aria-label={`Go to ${s.label} section`}
    >
      {s.label}
    </a>
  ))}
</div>

<!-- ══ MOBILE vine — fixed right, thin, no labels ══ -->
<div class="tree-mobile" id="tree-mobile" aria-hidden="true">
  <svg viewBox="0 0 20 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Thin vine path -->
    <path
      d="M10,0 C9,15 11,30 9.5,45 C8,60 11,75 9.5,90 C8.5,97 10,100 10,100"
      stroke="#5C5840" stroke-width="1.2" fill="none" opacity="0.4" stroke-linecap="round"
    />
    <!-- Dot markers for each section -->
    {sections.map(s => (
      <g class="mobile-dot" id={`mdot-${s.id}`} data-section={s.id}>
        <circle cx="10" cy={s.yPct} r="2.2" fill="none" stroke="#5C5840" stroke-width="0.9" opacity="0.45"/>
        <circle class="dot-fill" cx="10" cy={s.yPct} r="1.2" fill="#5C5840" opacity="0"/>
      </g>
    ))}
  </svg>
</div>

<style>
  /* ══ Desktop ══ */
  .tree-desktop {
    display: none;
    position: fixed;
    left: 10px;
    top: 72px;
    width: 120px;
    height: calc(100vh - 72px - 32px);
    pointer-events: none;
    z-index: 20;
  }
  @media (min-width: 1024px) {
    .tree-desktop { display: block; }
  }

  .tree-svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  /* Branch default state — muted */
  .tree-branch {
    opacity: 0.28;
    transition: opacity 0.5s ease;
  }
  .tree-branch.bloomed {
    opacity: 1;
  }

  /* Leaf bloom — scales in from branch tip */
  .branch-leaf {
    transform-box: fill-box;
    transform-origin: 0% 50%;
    transform: scale(0);
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .tree-branch.bloomed .branch-leaf {
    transform: scale(1);
  }

  /* Active label (bloomed section) shifts color */
  .tree-branch.bloomed ~ a.tree-label[data-label-for],
  a.tree-label.label-bloomed {
    color: #2B2825;
    opacity: 1;
  }

  /* Labels */
  .tree-label {
    position: absolute;
    left: 72px;
    font-family: 'Caveat', cursive;
    font-size: 14px;
    color: #5C5840;
    opacity: 0.35;
    pointer-events: all;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.5s ease, color 0.5s ease;
    line-height: 1;
  }
  .tree-label.label-bloomed {
    opacity: 1;
    color: #2B2825;
  }
  .tree-label:hover {
    opacity: 1 !important;
    color: #2B2825 !important;
  }

  /* Hide labels at medium desktop (tree trunk still shows, no labels) */
  @media (min-width: 1024px) and (max-width: 1399px) {
    .tree-label { display: none; }
  }

  /* ══ Mobile vine ══ */
  .tree-mobile {
    display: block;
    position: fixed;
    right: 8px;
    top: 72px;
    width: 20px;
    height: calc(100vh - 72px - 32px);
    pointer-events: none;
    z-index: 20;
  }
  @media (min-width: 1024px) {
    .tree-mobile { display: none; }
  }

  .mobile-dot { opacity: 0.35; transition: opacity 0.4s ease; }
  .mobile-dot.bloomed { opacity: 1; }
  .mobile-dot.bloomed .dot-fill { opacity: 1 !important; }

  /* Reduced motion — skip bloom animation, jump to end state */
  @media (prefers-reduced-motion: reduce) {
    .branch-leaf { transition: none; }
    .tree-branch { transition: opacity 0.01s; }
  }
</style>

<script>
  // ── Section IntersectionObserver ──
  // Branches stay lit once visited (tree fills out as you read).

  function bloom(sectionId: string) {
    // Desktop branch
    const branch = document.getElementById(`branch-${sectionId}`);
    branch?.classList.add('bloomed');

    // Desktop label
    const label = document.querySelector<HTMLElement>(`.tree-label[data-label-for="${sectionId}"]`);
    label?.classList.add('label-bloomed');

    // Mobile dot
    const dot = document.getElementById(`mdot-${sectionId}`);
    dot?.classList.add('bloomed');
  }

  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          bloom(e.target.id);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -20% 0px' }
  );

  ['about', 'work', 'switzerland', 'work-with-me'].forEach(id => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  // ── Smooth scroll on label click ──
  document.querySelectorAll<HTMLAnchorElement>('.tree-label').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      const target = document.querySelector(a.getAttribute('href') || '');
      if (target) target.scrollIntoView({ behavior: 'smooth' });
    });
  });
</script>
