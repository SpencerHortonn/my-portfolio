---
// Switzerland — edit copy and image URLs below

// TODO: replace with real trip photos once you're in Switzerland
const images = [
  {
    // Lausanne cathedral and rooftops above Lake Geneva — the city itself
    url: 'https://images.unsplash.com/photo-1559589688-6ba6beafe1e3?w=1200&q=88&auto=format&fit=crop',
    alt: 'Lausanne rooftops and cathedral above Lake Geneva',
  },
  {
    // Dramatic Swiss Alps — the mountains Spencer is heading toward
    url: 'https://images.unsplash.com/photo-1501854140801-50d01698950b?w=800&q=85&auto=format&fit=crop',
    alt: 'Swiss Alps — dramatic aerial mountain range',
  },
];
---

<section id="switzerland" class="py-24 md:py-40 bg-f-blue-pl">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">

      <!-- Images: wide shot + square + pull-quote tile -->
      <div class="reveal">
        <div class="aspect-video overflow-hidden mb-3">
          <img
            src={images[0].url}
            alt={images[0].alt}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="aspect-square overflow-hidden">
            <img
              src={images[1].url}
              alt={images[1].alt}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <!-- Pull-quote tile -->
          <div class="aspect-square bg-f-blue-lt flex items-end p-5">
            <p class="font-serif italic text-f-blue text-xl leading-tight">
              &ldquo;Going<br />anyway.&rdquo;
            </p>
          </div>
        </div>
      </div>

      <!-- Copy + form -->
      <div class="reveal reveal-d1">
        <p class="font-sans text-xs tracking-[0.25em] uppercase text-f-blue mb-5">
          June 28 &ndash; Nov 22, 2026
        </p>
        <h2 class="font-serif text-4xl md:text-5xl font-light text-f-ink leading-tight mb-8">
          Switzerland<br />
          is next.
        </h2>

        <div class="space-y-4 mb-10">
          <p class="font-sans text-base md:text-[17px] text-f-gray font-light leading-relaxed">
            On June 28th I leave for Switzerland for YWAM DTS — a five-month discipleship and mission training program that runs through November 22nd. It's not a gap year. It's not a sabbatical. It's where I'm supposed to be, and I can't really explain it better than that.
          </p>
          <p class="font-sans text-base md:text-[17px] text-f-gray font-light leading-relaxed">
            I'll be creating the whole time — the places, the people, whatever God's doing in the middle of it. If you want to follow along, drop your email below. I'll reach out when things go live.
          </p>
        </div>

        <!--
          Email signup form — UI only.
          TODO: wire this up to a real email service before launch.
          Good options: Mailchimp, ConvertKit, Resend, Loops.so
        -->
        <form
          class="flex flex-col sm:flex-row gap-3"
          onsubmit="handleSignup(event)"
          aria-label="Switzerland follow-along signup"
          novalidate
        >
          <label for="email-signup" class="sr-only">Your email address</label>
          <input
            id="email-signup"
            type="email"
            placeholder="your@email.com"
            required
            autocomplete="email"
            class="flex-1 px-4 py-3 bg-f-white border border-f-border text-f-ink font-sans text-sm placeholder:text-f-gray/50 focus:outline-none focus:border-f-blue transition-colors"
          />
          <button
            type="submit"
            class="px-6 py-3 bg-f-ink text-f-white font-sans text-xs tracking-[0.15em] uppercase hover:bg-f-ink/80 transition-colors whitespace-nowrap"
          >
            Follow along
          </button>
        </form>

        <p class="font-sans text-xs text-f-gray/50 mt-2">
          No spam. Just updates from the road.
        </p>

        <div id="signup-success" class="hidden mt-4 font-sans text-sm text-f-blue">
          You're in. I'll be in touch.
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Placeholder submit handler — replace with real API call
  function handleSignup(e: Event) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const success = document.getElementById('signup-success');
    form.style.display = 'none';
    success?.classList.remove('hidden');
  }
  // Make it available globally for the inline onsubmit
  (window as any).handleSignup = handleSignup;
</script>
