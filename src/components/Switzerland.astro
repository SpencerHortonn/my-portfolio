---
// Switzerland — copy is admin-editable at /admin/settings.
interface Props {
  dateRange: string;
  paragraphs: string[];
}
const { dateRange, paragraphs } = Astro.props;

// TODO: replace with real trip photos once you're in Switzerland
const images = [
  {
    // Lake Geneva at dusk with Alps beyond — the view from Lausanne
    url: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1200&q=88&auto=format&fit=crop',
    alt: 'Lake Geneva with Alps in background — view from Lausanne',
  },
  {
    // Swiss Alps aerial — dramatic peaks, the mountains surrounding YWAM
    url: 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=800&q=85&auto=format&fit=crop',
    alt: 'Swiss Alps — snow-covered peaks, aerial view',
  },
];
---

<section id="switzerland" class="py-24 md:py-40">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">

      <!-- Images: wide shot + square + pull-quote tile -->
      <div class="reveal">
        <div class="aspect-video overflow-hidden mb-3">
          <img
            src={images[0].url}
            alt={images[0].alt}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="aspect-square overflow-hidden">
            <img
              src={images[1].url}
              alt={images[1].alt}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <!-- Pull-quote tile -->
          <div class="aspect-square flex items-end p-5" style="background: #EEE6D6; border: 1px solid #BFB39C;">
            <p class="font-serif italic text-f-ink-deep text-xl leading-tight">
              &ldquo;Going<br />anyway.&rdquo;
            </p>
          </div>
        </div>
      </div>

      <!-- Copy + form -->
      <div class="reveal reveal-d1">
        <p class="font-sans text-xs tracking-[0.25em] uppercase text-f-gray mb-5">
          {dateRange}
        </p>
        <h2 class="font-serif text-4xl md:text-5xl font-light text-f-ink leading-tight mb-8">
          Switzerland<br />
          is next.
        </h2>

        <div class="space-y-4 mb-10">
          {paragraphs.map(p => (
            <p class="font-sans text-base md:text-[17px] text-f-gray font-light leading-relaxed">{p}</p>
          ))}
        </div>

        <form
          id="switzerland-signup-form"
          class="flex flex-col sm:flex-row gap-3"
          aria-label="Switzerland follow-along signup"
          novalidate
        >
          <label for="email-signup" class="sr-only">Your email address</label>
          <input
            id="email-signup"
            type="email"
            placeholder="your@email.com"
            required
            autocomplete="email"
            class="flex-1 px-4 py-3 bg-f-white border border-f-border text-f-ink font-sans text-sm placeholder:text-f-gray/50 focus:outline-none focus:border-f-ink transition-colors"
          />
          <button
            type="submit"
            class="px-6 py-3 bg-f-ink text-f-white font-sans text-xs tracking-[0.15em] uppercase hover:bg-f-ink/80 transition-colors whitespace-nowrap"
          >
            Follow along
          </button>
        </form>

        <p class="font-sans text-xs text-f-gray/50 mt-2">
          No spam. Just updates from the road.
        </p>

        <div id="signup-success" class="hidden mt-4 font-sans text-sm text-f-ink">
          You're in. I'll be in touch.
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('switzerland-signup-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.querySelector('#email-signup') as HTMLInputElement)?.value || '';
    const success = document.getElementById('signup-success');
    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (res.ok) {
        form.style.display = 'none';
        success?.classList.remove('hidden');
      }
    } catch (_) {
      // Silently ignore — the form just won't confirm success
    }
  });
</script>
