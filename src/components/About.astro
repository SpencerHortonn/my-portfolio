---
// About — edit copy directly in the array below
const paragraphs = [
  `I'm 17, based in Tyler, Texas, and I've been making things with a camera long enough that it stopped feeling like a hobby and started feeling like the only thing that made sense. Films, photos, short-form content — I care about what a frame makes you feel, not how it performs. If a shot doesn't make someone stop and actually feel something, I wasn't paying attention.`,
  `I'm not interested in building a career that looks good on paper but costs everything else. I'd rather make work that means something and figure out the money as it comes than flip that around. That's not a philosophy I picked up somewhere. It's just what's been true every time I've been honest about it.`,
  `This June I'm heading to Switzerland for YWAM DTS — a five-month discipleship training program that runs through November. It's not a gap year. It's not an escape. It's where I'm supposed to be, and I can't really explain it better than that. I'm bringing my camera. I'll be creating the whole time.`,
];

// Local image from public/ — the CSS global filter applies to this automatically
const profileImage = '/image%20for%20about%20me.JPG';
---

<section id="about" class="py-24 md:py-40">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-28 items-center">

      <!-- Copy -->
      <div class="order-2 md:order-1">
        <p class="font-sans text-xs tracking-[0.25em] uppercase text-f-blue mb-5 reveal">
          About
        </p>
        <h2 class="font-serif text-4xl md:text-5xl font-light text-f-ink leading-tight mb-10 reveal reveal-d1">
          Filmmaker.<br />
          Photographer.<br />
          <em>Going somewhere.</em>
        </h2>
        <div class="space-y-5">
          {paragraphs.map((p, i) => (
            <p class={`font-sans text-base md:text-[17px] text-f-gray font-light leading-relaxed reveal reveal-d${Math.min(i + 2, 4)}`}>
              {p}
            </p>
          ))}
        </div>
      </div>

      <!-- Portrait image + field note -->
      <div class="order-1 md:order-2 reveal reveal-d1">
        <div class="relative aspect-[3/4] overflow-hidden">
          <img
            src={profileImage}
            alt="Spencer Lane — filmmaker and photographer"
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 ring-1 ring-inset ring-f-ink/8 pointer-events-none" aria-hidden="true"></div>
        </div>
        <!-- Caption below image -->
        <p class="font-sans text-xs text-f-gray/60 tracking-wide mt-3">
          Tyler, TX &mdash; 2025
        </p>
        <!-- Field note — director's annotation -->
        <p class="field-note mt-4 transform -rotate-1 inline-block" aria-label="Field note">
          seventeen. still figuring it out.
        </p>
      </div>

    </div>
  </div>
</section>
