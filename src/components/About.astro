---
const paragraphs = [
  `I'm 17, based in Tyler, Texas, and I've been making things with a camera long enough that it stopped feeling like a hobby and started feeling like the only thing that made sense. Films, photos, short-form content — I care about what a frame makes you feel, not how it performs.`,
  `I'm not interested in building a career that looks good on paper but costs everything else. I'd rather make work that means something and figure out the money as it comes than flip that around. That's not a philosophy I picked up somewhere. It's just what's been true every time I've been honest about it.`,
  `This June I'm heading to Switzerland for YWAM DTS — five months through November. It's not a gap year. It's not an escape. It's where I'm supposed to be, and I can't really explain it better than that. I'm bringing my camera.`,
];

const profileImage = '/image%20for%20about%20me.JPG';
---

<section id="about" class="py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-14 md:gap-24 items-center">

      <!-- Copy — left column -->
      <div class="order-2 md:order-1">
        <p class="font-sans text-xs tracking-[0.25em] uppercase text-f-gray mb-5 reveal">
          About
        </p>
        <h2 class="font-serif text-4xl md:text-5xl font-light text-f-ink leading-tight mb-8 reveal reveal-d1">
          Filmmaker.<br />
          Photographer.<br />
          <em>Going somewhere.</em>
        </h2>
        <div class="space-y-5">
          {paragraphs.map((p, i) => (
            <p class={`font-sans text-base md:text-[17px] text-f-gray font-light leading-relaxed reveal reveal-d${Math.min(i + 2, 4)}`}>
              {p}
            </p>
          ))}
        </div>
      </div>

      <!-- Portrait as polaroid — right column, in conversation with the text -->
      <div class="order-1 md:order-2 flex flex-col items-center reveal reveal-d1">
        <div class="polaroid-about">
          <img
            src={profileImage}
            alt="Spencer Lane — filmmaker and photographer"
            class="polaroid-about-img"
            loading="lazy"
          />
          <!-- Field note as polaroid caption -->
          <p class="polaroid-about-caption">seventeen. still figuring it out.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .polaroid-about {
    background: #EDE4CF;
    padding: 14px 14px 56px;
    box-shadow: 3px 5px 22px rgba(43,40,37,0.16), 0 1px 4px rgba(43,40,37,0.08);
    transform: rotate(-1.6deg);
    max-width: 320px;
    width: 100%;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .polaroid-about:hover {
    transform: rotate(-0.3deg) scale(1.01);
  }
  .polaroid-about-img {
    display: block;
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    filter: contrast(0.89) saturate(0.78) sepia(0.10) brightness(0.97) !important;
    opacity: 1 !important;
    transition: none !important;
  }
  .polaroid-about-caption {
    font-family: 'Caveat', cursive;
    font-size: 16px;
    color: #6B6357;
    text-align: center;
    margin-top: 12px;
    line-height: 1.3;
  }
</style>
