---
import { site } from '../config/content';

const heroImage =
  'https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=1920&q=85&auto=format&fit=crop';
---

<section
  id="hero"
  class="relative w-full h-screen min-h-[600px] flex items-end pb-20 md:pb-32 overflow-hidden"
  aria-label="Hero"
>
  <!-- Background — Ken Burns handled by CSS -->
  <div
    id="hero-bg"
    class="absolute inset-0 hero-kb"
    style={`background-image: url('${heroImage}'); background-size: cover; background-position: center;`}
    role="img"
    aria-label="Coastal landscape — warm, sun-bleached tones"
  ></div>

  <!-- Bottom-fade -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-f-white via-f-white/25 to-transparent"
    aria-hidden="true"
  ></div>

  <!-- Vignette -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse at 50% 45%, transparent 35%, rgba(26,24,21,0.52) 100%);"
    aria-hidden="true"
  ></div>

  <!-- Film frame number — top right -->
  <div class="absolute top-24 right-6 md:right-10 hidden sm:block" aria-hidden="true">
    <span class="font-sans text-[9px] tracking-[0.22em] uppercase text-f-gray/40">01</span>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
    <p class="font-sans text-xs tracking-[0.28em] uppercase text-f-gray mb-5 reveal">
      Tyler, TX &mdash; Est. 2008
    </p>

    <!-- Name + hand-drawn underline -->
    <div class="relative inline-block mb-6 reveal reveal-d1">
      <h1
        class="font-serif font-light text-f-ink leading-none"
        style="font-size: clamp(3.5rem, 10vw, 8rem); letter-spacing: 0.02em;"
      >
        {site.name}
      </h1>
      <!-- Hand-drawn underline SVG -->
      <svg
        class="absolute -bottom-3 left-0 w-full overflow-visible"
        height="10"
        viewBox="0 0 400 10"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          class="hero-underline-path"
          d="M2,6 C60,2 120,9 180,5 C240,1 300,8 398,5"
          stroke="#A8C8DC"
          stroke-width="1.8"
          fill="none"
          stroke-linecap="round"
        />
      </svg>
    </div>

    <p class="font-serif italic text-xl md:text-2xl text-f-gray font-light max-w-sm leading-snug reveal reveal-d2">
      {site.tagline}
    </p>
  </div>

  <!-- Scroll cue -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 reveal reveal-d3"
    aria-hidden="true"
  >
    <span class="font-sans text-[9px] tracking-[0.28em] uppercase text-f-gray/60">Scroll</span>
    <div class="scroll-line w-px h-10 bg-f-gray/40"></div>
  </div>
</section>

<style>
  /* Ken Burns — slow drift, no JS needed */
  .hero-kb {
    animation: ken-burns 28s ease-in-out infinite alternate;
    transform-origin: center center;
  }
  @keyframes ken-burns {
    from { transform: scale(1.0)  translate(0%,    0%   ); }
    to   { transform: scale(1.07) translate(-0.8%, 0.6% ); }
  }

  .scroll-line {
    animation: line-drop 2.2s ease-in-out infinite;
    transform-origin: top center;
  }
  @keyframes line-drop {
    0%, 100% { opacity: 0.25; transform: scaleY(0.4); }
    50%       { opacity: 0.8;  transform: scaleY(1);   }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-kb { animation: none; }
  }
</style>
