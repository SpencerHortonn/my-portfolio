---
import Layout          from '../layouts/Layout.astro';
import Hero             from '../components/Hero.astro';
import ClientLogoStrip  from '../components/ClientLogoStrip.astro';
import Footer           from '../components/Footer.astro';
import ClosingCard      from '../components/ClosingCard.astro';
import { getSettings, listPortfolioItems } from '../lib/db';
import { DEFAULT_SETTINGS } from '../lib/defaultSettings';

const [s, portfolioItems] = await Promise.all([
  getSettings(Object.keys(DEFAULT_SETTINGS)),
  listPortfolioItems({ publishedOnly: true }),
]);
const settings = { ...DEFAULT_SETTINGS, ...s };

const clients = portfolioItems
  .filter(item => item.client_logo)
  .map(item => ({ name: item.client_name || item.title, logo: item.client_logo, slug: item.slug }));
---

<Layout>
  <Hero
    name={settings.site_name}
    tagline={settings.hero_tagline}
    mediaType={settings.hero_media.type}
    mediaUrl={settings.hero_media.url}
  />

  <ClientLogoStrip clients={clients} />

  <Footer
    siteName={settings.site_name}
    email={settings.contact.email}
    phone={settings.contact.phone}
    phoneTel={settings.contact.phoneTel}
    tiktok={settings.socials.tiktok}
    instagram={settings.socials.instagram}
    youtube={settings.socials.youtube}
  />

  <ClosingCard />
</Layout>
