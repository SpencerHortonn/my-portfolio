---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSetting } from '../../lib/db';
import { DEFAULT_SETTINGS } from '../../lib/defaultSettings';

const workWithMe = await getSetting('work_with_me', DEFAULT_SETTINGS.work_with_me);
const saved = Astro.url.searchParams.get('saved') === '1';

const servicesAsLines = workWithMe.services.map((s: { title: string; desc: string }) => `${s.title} | ${s.desc}`).join('\n');
---

<AdminLayout title="Work With Me">
  <div class="flex items-baseline justify-between mb-2">
    <h1 class="font-serif text-3xl font-light text-f-ink-deep">Work With Me</h1>
    <a href="/work-with-me" target="_blank" class="font-sans text-xs text-f-gray hover:text-f-ink underline">View live page →</a>
  </div>
  <p class="font-sans text-sm text-f-gray mb-8">
    Pricing isn't published on the site on purpose — it stays "contact for personalized pricing."
  </p>

  {saved && (
    <p class="font-sans text-sm text-green-800 bg-green-50 border border-green-800/30 px-4 py-2 mb-6 inline-block">
      Saved.
    </p>
  )}

  <form method="POST" action="/api/admin/work-with-me" class="flex flex-col gap-6">
    <div>
      <label class="admin-label" for="intro">Intro paragraph</label>
      <textarea class="admin-textarea" id="intro" name="intro" rows="4">{workWithMe.intro}</textarea>
    </div>

    <div>
      <label class="admin-label" for="services">
        Services — one per line, format: <code>Title | Description</code>
      </label>
      <textarea class="admin-textarea" id="services" name="services" rows="8">{servicesAsLines}</textarea>
    </div>

    <div>
      <button type="submit" class="admin-btn">Save changes</button>
    </div>
  </form>
</AdminLayout>
