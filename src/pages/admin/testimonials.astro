---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getTestimonial, listPortfolioItems, listTestimonials } from '../../lib/db';

const [testimonials, caseStudies] = await Promise.all([
  listTestimonials(),
  listPortfolioItems(),
]);

const editId = Astro.url.searchParams.get('edit');
const editing = editId ? await getTestimonial(Number(editId)) : null;
---

<AdminLayout title="Testimonials">
  <div class="flex items-baseline justify-between mb-8">
    <h1 class="font-serif text-3xl font-light text-f-ink-deep">Testimonials</h1>
    <a href="/portfolio" target="_blank" class="font-sans text-xs text-f-gray hover:text-f-ink underline">View live page →</a>
  </div>

  <p class="font-sans text-sm text-f-gray mb-8 max-w-2xl">
    Shown as a rotating strip on the Portfolio page. Link one to a specific case study and it'll also show on that
    project's own page.
  </p>

  <!-- ── Add / edit form ── -->
  <section class="border border-f-border bg-f-paper-warm p-6 mb-10">
    <h2 class="font-serif text-xl text-f-ink-deep mb-5">{editing ? 'Edit testimonial' : 'Add new testimonial'}</h2>

    <form method="POST" action="/api/admin/testimonials" enctype="multipart/form-data" class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {editing && <input type="hidden" name="id" value={editing.id} />}

      <div class="md:col-span-2">
        <label class="admin-label" for="quote">Quote</label>
        <textarea class="admin-textarea" id="quote" name="quote" rows="3" required>{editing?.quote ?? ''}</textarea>
      </div>

      <div>
        <label class="admin-label" for="author_name">Author name</label>
        <input class="admin-input" id="author_name" name="author_name" required value={editing?.author_name ?? ''} placeholder="e.g. Pastor John Smith" />
      </div>
      <div>
        <label class="admin-label" for="author_role">Role / company</label>
        <input class="admin-input" id="author_role" name="author_role" value={editing?.author_role ?? ''} placeholder="e.g. Green Acres Baptist Church" />
      </div>

      <div>
        <label class="admin-label" for="photo">Photo URL (optional)</label>
        <input class="admin-input" id="photo" name="photo" value={editing?.photo ?? ''} />
      </div>
      <div>
        <label class="admin-label" for="photo_file">...or upload a photo</label>
        <input class="admin-input" id="photo_file" name="photo_file" type="file" accept="image/*" />
      </div>

      <div class="md:col-span-2">
        <label class="admin-label" for="case_study_id">Link to a case study (optional)</label>
        <select class="admin-select" id="case_study_id" name="case_study_id">
          <option value="">— None, just show in the general rotation —</option>
          {caseStudies.map(cs => (
            <option value={cs.id} selected={editing?.case_study_id === cs.id}>{cs.title}</option>
          ))}
        </select>
      </div>

      <label class="flex items-center gap-2 font-sans text-sm text-f-gray">
        <input type="checkbox" name="published" checked={editing ? editing.published : true} />
        Published (visible on the live site)
      </label>

      <div class="md:col-span-2 flex items-center gap-3">
        <button type="submit" class="admin-btn">{editing ? 'Save changes' : 'Add testimonial'}</button>
        {editing && <a href="/admin/testimonials" class="admin-btn admin-btn-ghost">Cancel</a>}
      </div>
    </form>
  </section>

  <!-- ── List ── -->
  <section class="flex flex-col gap-3">
    {testimonials.length === 0 && <p class="font-sans text-sm text-f-gray">No testimonials yet.</p>}
    {testimonials.map((t, i) => (
      <div class="border border-f-border bg-white p-4 flex items-center gap-4">
        {t.photo
          ? <img src={t.photo} alt="" class="w-12 h-12 rounded-full object-cover bg-f-paper-warm flex-shrink-0" />
          : <div class="w-12 h-12 rounded-full bg-f-paper-warm flex-shrink-0" />}
        <div class="flex-1 min-w-0">
          <p class="font-serif text-sm text-f-ink-deep truncate">&ldquo;{t.quote}&rdquo;</p>
          <p class="font-sans text-xs text-f-gray">
            {t.author_name} · {t.author_role} · {t.published ? 'published' : 'hidden'}
          </p>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <form method="POST" action="/api/admin/testimonials">
            <input type="hidden" name="intent" value="move" />
            <input type="hidden" name="id" value={t.id} />
            <input type="hidden" name="direction" value="up" />
            <button type="submit" class="admin-btn admin-btn-ghost" disabled={i === 0} aria-label="Move up">↑</button>
          </form>
          <form method="POST" action="/api/admin/testimonials">
            <input type="hidden" name="intent" value="move" />
            <input type="hidden" name="id" value={t.id} />
            <input type="hidden" name="direction" value="down" />
            <button type="submit" class="admin-btn admin-btn-ghost" disabled={i === testimonials.length - 1} aria-label="Move down">↓</button>
          </form>
          <a href={`/admin/testimonials?edit=${t.id}`} class="admin-btn admin-btn-ghost">Edit</a>
          <form method="POST" action="/api/admin/testimonials" onsubmit="return confirm('Delete this testimonial?')">
            <input type="hidden" name="intent" value="delete" />
            <input type="hidden" name="id" value={t.id} />
            <button type="submit" class="admin-btn admin-btn-danger">Delete</button>
          </form>
        </div>
      </div>
    ))}
  </section>
</AdminLayout>
