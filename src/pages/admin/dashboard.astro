---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listContactMessages, listPortfolioItems, listShopProducts, listTestimonials } from '../../lib/db';

const [portfolio, products, testimonials, messages] = await Promise.all([
  listPortfolioItems(),
  listShopProducts(),
  listTestimonials(),
  listContactMessages(),
]);

const cards = [
  { href: '/admin/portfolio', label: 'Portfolio / case studies', count: portfolio.length, desc: 'Client and personal work shown on /portfolio, each with its own case study page.' },
  { href: '/admin/testimonials', label: 'Testimonials', count: testimonials.length, desc: 'Rotating quotes on /portfolio — link one to a specific case study to show it there too.' },
  { href: '/admin/shop', label: 'Shop products', count: products.length, desc: 'LUTs/presets shown on /shop — Stripe-ready, checkout not wired up yet.' },
  { href: '/admin/work-with-me', label: 'Work With Me', count: null, desc: 'Intro copy and services list shown on /work-with-me.' },
  { href: '/admin/messages', label: 'Messages', count: messages.length, desc: 'Contact form submissions — also emailed to you directly.' },
  { href: '/admin/settings', label: 'Site settings', count: null, desc: 'Hero media, bio, contact info, socials, and which nav tabs show.' },
];
---

<AdminLayout title="Dashboard">
  <h1 class="font-serif text-3xl font-light text-f-ink-deep mb-8">Dashboard</h1>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {cards.map(card => (
      <a href={card.href} class="block border border-f-border bg-f-paper-warm p-6 hover:border-f-ink transition-colors">
        <div class="flex items-baseline justify-between mb-2">
          <h2 class="font-serif text-xl text-f-ink-deep">{card.label}</h2>
          {card.count !== null && (
            <span class="font-mono text-xs text-f-gray">{card.count}</span>
          )}
        </div>
        <p class="font-sans text-sm text-f-gray">{card.desc}</p>
      </a>
    ))}
  </div>

  <p class="font-sans text-xs text-f-gray mt-10">
    Changes made here go live immediately — no redeploy needed.
  </p>
</AdminLayout>
