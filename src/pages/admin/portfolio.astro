---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getPortfolioItem, listPortfolioItems } from '../../lib/db';

const items = await listPortfolioItems();

const editId = Astro.url.searchParams.get('edit');
const editing = editId ? await getPortfolioItem(Number(editId)) : null;
---

<AdminLayout title="Portfolio">
  <div class="flex items-baseline justify-between mb-8">
    <h1 class="font-serif text-3xl font-light text-f-ink-deep">Portfolio</h1>
    <a href="/portfolio" target="_blank" class="font-sans text-xs text-f-gray hover:text-f-ink underline">View live page →</a>
  </div>

  <!-- ── Add / edit form ── -->
  <section class="border border-f-border bg-f-paper-warm p-6 mb-10">
    <h2 class="font-serif text-xl text-f-ink-deep mb-5">{editing ? `Edit — ${editing.title}` : 'Add new item'}</h2>

    <form method="POST" action="/api/admin/portfolio" enctype="multipart/form-data" class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {editing && <input type="hidden" name="id" value={editing.id} />}

      <div class="md:col-span-2">
        <label class="admin-label" for="title">Title</label>
        <input class="admin-input" id="title" name="title" required value={editing?.title ?? ''} />
      </div>

      <div>
        <label class="admin-label" for="client_name">Client name (leave blank for a personal project)</label>
        <input class="admin-input" id="client_name" name="client_name" value={editing?.client_name ?? ''} placeholder="e.g. Green Acres Baptist Church" />
      </div>
      <div>
        <label class="admin-label" for="slug">URL slug (leave blank to auto-generate)</label>
        <input class="admin-input" id="slug" name="slug" value={editing?.slug ?? ''} placeholder="green-acres-promo" />
      </div>

      <div>
        <label class="admin-label" for="client_logo">Client logo URL (shown in the homepage logo strip)</label>
        <input class="admin-input" id="client_logo" name="client_logo" value={editing?.client_logo ?? ''} />
      </div>
      <div>
        <label class="admin-label" for="client_logo_file">...or upload a logo</label>
        <input class="admin-input" id="client_logo_file" name="client_logo_file" type="file" accept="image/*" />
      </div>

      <div class="md:col-span-2">
        <label class="admin-label" for="caption">Caption (shown on the grid tile)</label>
        <input class="admin-input" id="caption" name="caption" value={editing?.caption ?? ''} placeholder="e.g. Short film — 2026" />
      </div>

      <div class="md:col-span-2">
        <label class="admin-label" for="description">Description — what you delivered (shown on the case study page)</label>
        <textarea class="admin-textarea" id="description" name="description" rows="4">{editing?.description ?? ''}</textarea>
      </div>

      <div>
        <label class="admin-label" for="type">Type</label>
        <select class="admin-select" id="type" name="type">
          {['video', 'photo', 'gallery'].map(t => (
            <option value={t} selected={editing?.type === t}>{t}</option>
          ))}
        </select>
      </div>

      <div>
        <label class="admin-label" for="orientation">Orientation</label>
        <select class="admin-select" id="orientation" name="orientation">
          {['landscape', 'portrait'].map(o => (
            <option value={o} selected={editing?.orientation === o}>{o}</option>
          ))}
        </select>
      </div>

      <div>
        <label class="admin-label" for="thumbnail">Thumbnail URL</label>
        <input class="admin-input" id="thumbnail" name="thumbnail" value={editing?.thumbnail ?? ''} placeholder="/some-image.jpg or https://..." />
      </div>
      <div>
        <label class="admin-label" for="thumbnail_file">...or upload a thumbnail</label>
        <input class="admin-input" id="thumbnail_file" name="thumbnail_file" type="file" accept="image/*" />
      </div>

      <div>
        <label class="admin-label" for="embed_url">Video embed URL (YouTube/Vimeo)</label>
        <input class="admin-input" id="embed_url" name="embed_url" value={editing?.embed_url ?? ''} placeholder="https://www.youtube.com/embed/..." />
      </div>
      <div>
        <label class="admin-label" for="full_url">Full-res photo URL</label>
        <input class="admin-input" id="full_url" name="full_url" value={editing?.full_url ?? ''} />
      </div>

      <div class="md:col-span-2">
        <label class="admin-label" for="images">Gallery images (one URL per line — only used when type is "gallery")</label>
        <textarea class="admin-textarea" id="images" name="images" rows="4">{(editing?.images ?? []).join('\n')}</textarea>
      </div>

      <label class="flex items-center gap-2 font-sans text-sm text-f-gray">
        <input type="checkbox" name="published" checked={editing ? editing.published : true} />
        Published (visible on the live site)
      </label>

      <div class="md:col-span-2 flex items-center gap-3">
        <button type="submit" class="admin-btn">{editing ? 'Save changes' : 'Add item'}</button>
        {editing && <a href="/admin/portfolio" class="admin-btn admin-btn-ghost">Cancel</a>}
      </div>
    </form>
  </section>

  <!-- ── List ── -->
  <section class="flex flex-col gap-3">
    {items.length === 0 && <p class="font-sans text-sm text-f-gray">No portfolio items yet.</p>}
    {items.map((item, i) => (
      <div class="border border-f-border bg-white p-4 flex items-center gap-4">
        <img src={item.thumbnail} alt="" class="w-16 h-16 object-cover bg-f-paper-warm flex-shrink-0" />
        <div class="flex-1 min-w-0">
          <p class="font-serif text-base text-f-ink-deep truncate">{item.title}</p>
          <p class="font-sans text-xs text-f-gray">
            {item.client_name || 'Personal'} · {item.type} · {item.orientation} · {item.published ? 'published' : 'hidden'}
          </p>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <form method="POST" action="/api/admin/portfolio">
            <input type="hidden" name="intent" value="move" />
            <input type="hidden" name="id" value={item.id} />
            <input type="hidden" name="direction" value="up" />
            <button type="submit" class="admin-btn admin-btn-ghost" disabled={i === 0} aria-label="Move up">↑</button>
          </form>
          <form method="POST" action="/api/admin/portfolio">
            <input type="hidden" name="intent" value="move" />
            <input type="hidden" name="id" value={item.id} />
            <input type="hidden" name="direction" value="down" />
            <button type="submit" class="admin-btn admin-btn-ghost" disabled={i === items.length - 1} aria-label="Move down">↓</button>
          </form>
          {item.slug && <a href={`/portfolio/${item.slug}`} target="_blank" class="admin-btn admin-btn-ghost">View</a>}
          <a href={`/admin/portfolio?edit=${item.id}`} class="admin-btn admin-btn-ghost">Edit</a>
          <form method="POST" action="/api/admin/portfolio" onsubmit="return confirm('Delete this item?')">
            <input type="hidden" name="intent" value="delete" />
            <input type="hidden" name="id" value={item.id} />
            <button type="submit" class="admin-btn admin-btn-danger">Delete</button>
          </form>
        </div>
      </div>
    ))}
  </section>
</AdminLayout>
