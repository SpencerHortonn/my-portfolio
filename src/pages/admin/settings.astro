---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSettings } from '../../lib/db';
import { DEFAULT_SETTINGS } from '../../lib/defaultSettings';

const s = await getSettings(Object.keys(DEFAULT_SETTINGS));
const settings = { ...DEFAULT_SETTINGS, ...s };

const saved = Astro.url.searchParams.get('saved') === '1';
---

<AdminLayout title="Settings">
  <h1 class="font-serif text-3xl font-light text-f-ink-deep mb-2">Site settings</h1>
  <p class="font-sans text-sm text-f-gray mb-8">
    Everything here shows up somewhere on the public site — save to publish immediately.
  </p>

  {saved && (
    <p class="font-sans text-sm text-green-800 bg-green-50 border border-green-800/30 px-4 py-2 mb-6 inline-block">
      Saved.
    </p>
  )}

  <form method="POST" action="/api/admin/settings" enctype="multipart/form-data" class="flex flex-col gap-10">

    <fieldset class="border border-f-border bg-f-paper-warm p-6 flex flex-col gap-5">
      <legend class="font-serif text-lg text-f-ink-deep px-2">Home / hero</legend>
      <div>
        <label class="admin-label" for="site_name">Site name</label>
        <input class="admin-input" id="site_name" name="site_name" value={settings.site_name} />
      </div>
      <div>
        <label class="admin-label" for="hero_tagline">Hero quote / tagline</label>
        <input class="admin-input" id="hero_tagline" name="hero_tagline" value={settings.hero_tagline} />
      </div>
      <div>
        <label class="admin-label" for="hero_media_type">Hero background type</label>
        <select class="admin-select" id="hero_media_type" name="hero_media_type">
          <option value="image" selected={settings.hero_media.type === 'image'}>Image</option>
          <option value="video" selected={settings.hero_media.type === 'video'}>Video (autoplay, muted, looping)</option>
        </select>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label class="admin-label" for="hero_media_url">Background URL</label>
          <input class="admin-input" id="hero_media_url" name="hero_media_url" value={settings.hero_media.url} />
        </div>
        <div>
          <label class="admin-label" for="hero_media_file">...or upload a file</label>
          <input class="admin-input" id="hero_media_file" name="hero_media_file" type="file" accept="image/*,video/*" data-blob-folder="hero" data-url-field="hero_media_url" />
        </div>
      </div>
    </fieldset>

    <fieldset class="border border-f-border bg-f-paper-warm p-6 flex flex-col gap-5">
      <legend class="font-serif text-lg text-f-ink-deep px-2">About page</legend>
      <div>
        <label class="admin-label" for="about_paragraphs">Bio (separate paragraphs with a blank line)</label>
        <textarea class="admin-textarea" id="about_paragraphs" name="about_paragraphs" rows="8">{settings.about_paragraphs.join('\n\n')}</textarea>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label class="admin-label" for="about_photo">Photo URL</label>
          <input class="admin-input" id="about_photo" name="about_photo" value={settings.about_photo} />
        </div>
        <div>
          <label class="admin-label" for="about_photo_file">...or upload a photo</label>
          <input class="admin-input" id="about_photo_file" name="about_photo_file" type="file" accept="image/*" data-blob-folder="about" />
        </div>
      </div>
    </fieldset>

    <fieldset class="border border-f-border bg-f-paper-warm p-6 flex flex-col gap-5">
      <legend class="font-serif text-lg text-f-ink-deep px-2">Contact & socials</legend>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label class="admin-label" for="contact_email">Email</label>
          <input class="admin-input" id="contact_email" name="contact_email" value={settings.contact.email} />
        </div>
        <div>
          <label class="admin-label" for="contact_phone">Phone (display)</label>
          <input class="admin-input" id="contact_phone" name="contact_phone" value={settings.contact.phone} />
        </div>
        <div>
          <label class="admin-label" for="contact_phone_tel">Phone (tel: link)</label>
          <input class="admin-input" id="contact_phone_tel" name="contact_phone_tel" value={settings.contact.phoneTel} placeholder="tel:+1..." />
        </div>
        <div>
          <label class="admin-label" for="contact_location">Location</label>
          <input class="admin-input" id="contact_location" name="contact_location" value={settings.contact.location} />
        </div>
        <div>
          <label class="admin-label" for="social_tiktok">TikTok URL</label>
          <input class="admin-input" id="social_tiktok" name="social_tiktok" value={settings.socials.tiktok} />
        </div>
        <div>
          <label class="admin-label" for="social_instagram">Instagram URL</label>
          <input class="admin-input" id="social_instagram" name="social_instagram" value={settings.socials.instagram} />
        </div>
        <div>
          <label class="admin-label" for="social_youtube">YouTube URL</label>
          <input class="admin-input" id="social_youtube" name="social_youtube" value={settings.socials.youtube} />
        </div>
      </div>
    </fieldset>

    <fieldset class="border border-f-border bg-f-paper-warm p-6 flex flex-col gap-5">
      <legend class="font-serif text-lg text-f-ink-deep px-2">Navigation — which tabs show</legend>
      <p class="font-sans text-xs text-f-gray -mt-2">
        Unchecking a tab only removes it from the menu — the page still works if someone has the direct link.
      </p>
      <div class="flex flex-col gap-3">
        <label class="flex items-center gap-2 font-sans text-sm text-f-gray">
          <input type="checkbox" name="nav_about" checked={settings.nav_visibility.about} />
          About
        </label>
        <label class="flex items-center gap-2 font-sans text-sm text-f-gray">
          <input type="checkbox" name="nav_portfolio" checked={settings.nav_visibility.portfolio} />
          Portfolio
        </label>
        <label class="flex items-center gap-2 font-sans text-sm text-f-gray">
          <input type="checkbox" name="nav_shop" checked={settings.nav_visibility.shop} />
          Shop
        </label>
        <label class="flex items-center gap-2 font-sans text-sm text-f-gray">
          <input type="checkbox" name="nav_work_with_me" checked={settings.nav_visibility.workWithMe} />
          Work With Me
        </label>
        <label class="flex items-center gap-2 font-sans text-sm text-f-gray">
          <input type="checkbox" name="nav_ugc" checked={settings.nav_visibility.ugc} />
          UGC (off by default — share <code>/ugc</code> as a direct link until you're ready to list it)
        </label>
      </div>
    </fieldset>

    <fieldset class="border border-f-border bg-f-paper-warm p-6 flex flex-col gap-5">
      <legend class="font-serif text-lg text-f-ink-deep px-2">UGC page copy</legend>
      <p class="font-sans text-xs text-f-gray -mt-2">
        Shown at the top of the hidden <code>/ugc</code> page. Manage the actual clips at <a href="/admin/ugc" class="underline hover:text-f-ink">/admin/ugc</a>.
      </p>
      <div>
        <label class="admin-label" for="ugc_headline">Headline</label>
        <input class="admin-input" id="ugc_headline" name="ugc_headline" value={settings.ugc_page.headline} />
      </div>
      <div>
        <label class="admin-label" for="ugc_intro">Intro paragraph</label>
        <textarea class="admin-textarea" id="ugc_intro" name="ugc_intro" rows="3">{settings.ugc_page.intro}</textarea>
      </div>
      <div>
        <label class="admin-label" for="ugc_contact_note">Contact line (above the CTA button)</label>
        <input class="admin-input" id="ugc_contact_note" name="ugc_contact_note" value={settings.ugc_page.contact_note} />
      </div>
    </fieldset>

    <div>
      <button type="submit" class="admin-btn">Save all changes</button>
    </div>
  </form>
</AdminLayout>
