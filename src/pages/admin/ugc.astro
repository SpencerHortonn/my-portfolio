---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getUgcItem, listUgcItems } from '../../lib/db';

const items = await listUgcItems();

const editId = Astro.url.searchParams.get('edit');
const editing = editId ? await getUgcItem(Number(editId)) : null;
---

<AdminLayout title="UGC">
  <div class="flex items-baseline justify-between mb-8">
    <h1 class="font-serif text-3xl font-light text-f-ink-deep">UGC</h1>
    <a href="/ugc" target="_blank" class="font-sans text-xs text-f-gray hover:text-f-ink underline">View live page →</a>
  </div>

  <p class="font-sans text-sm text-f-gray mb-8 max-w-2xl">
    Reels/clips shown on the hidden <code>/ugc</code> page — the one you send directly to travel brands. It's
    intentionally not in the main nav yet; flip it on anytime in <a href="/admin/settings" class="underline hover:text-f-ink">Settings → Navigation</a>.
  </p>

  <!-- ── Add / edit form ── -->
  <section class="border border-f-border bg-f-paper-warm p-6 mb-10">
    <h2 class="font-serif text-xl text-f-ink-deep mb-5">{editing ? 'Edit clip' : 'Add new clip'}</h2>

    <form method="POST" action="/api/admin/ugc" enctype="multipart/form-data" class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {editing && <input type="hidden" name="id" value={editing.id} />}

      <div>
        <label class="admin-label" for="brand_name">Brand name (optional)</label>
        <input class="admin-input" id="brand_name" name="brand_name" value={editing?.brand_name ?? ''} placeholder="e.g. Away Travel" />
      </div>
      <div>
        <label class="admin-label" for="platform">Platform (optional)</label>
        <input class="admin-input" id="platform" name="platform" value={editing?.platform ?? ''} placeholder="e.g. TikTok, Instagram Reel" />
      </div>

      <div class="md:col-span-2">
        <label class="admin-label" for="caption">Caption / what this clip shows</label>
        <textarea class="admin-textarea" id="caption" name="caption" rows="2">{editing?.caption ?? ''}</textarea>
      </div>

      <div>
        <label class="admin-label" for="thumbnail">Cover image URL</label>
        <input class="admin-input" id="thumbnail" name="thumbnail" value={editing?.thumbnail ?? ''} />
      </div>
      <div>
        <label class="admin-label" for="thumbnail_file">...or upload a cover image</label>
        <input class="admin-input" id="thumbnail_file" name="thumbnail_file" type="file" accept="image/*" data-blob-folder="ugc" />
      </div>

      <div>
        <label class="admin-label" for="embed_url">TikTok/Instagram/YouTube embed URL</label>
        <input class="admin-input" id="embed_url" name="embed_url" value={editing?.embed_url ?? ''} placeholder="https://www.tiktok.com/embed/..." />
      </div>
      <div>
        <label class="admin-label" for="video_file_file">...or upload a video file</label>
        <input class="admin-input" id="video_file_file" name="video_file_file" type="file" accept="video/*" data-blob-folder="ugc" />
        <input type="hidden" name="video_file" value={editing?.video_file ?? ''} />
        {editing?.video_file && <p class="font-sans text-xs text-f-gray mt-1">Current video uploaded ✓</p>}
      </div>

      <label class="flex items-center gap-2 font-sans text-sm text-f-gray">
        <input type="checkbox" name="published" checked={editing ? editing.published : true} />
        Published (visible on the live page)
      </label>

      <div class="md:col-span-2 flex items-center gap-3">
        <button type="submit" class="admin-btn">{editing ? 'Save changes' : 'Add clip'}</button>
        {editing && <a href="/admin/ugc" class="admin-btn admin-btn-ghost">Cancel</a>}
      </div>
    </form>
  </section>

  <!-- ── List ── -->
  <section class="flex flex-col gap-3">
    {items.length === 0 && <p class="font-sans text-sm text-f-gray">No clips yet.</p>}
    {items.map((item, i) => (
      <div class="border border-f-border bg-white p-4 flex items-center gap-4">
        {item.thumbnail
          ? <img src={item.thumbnail} alt="" class="w-12 h-16 object-cover bg-f-paper-warm flex-shrink-0" />
          : <div class="w-12 h-16 bg-f-paper-warm flex-shrink-0" />}
        <div class="flex-1 min-w-0">
          <p class="font-serif text-sm text-f-ink-deep truncate">{item.brand_name || 'Personal / unbranded'}</p>
          <p class="font-sans text-xs text-f-gray">
            {item.platform || 'No platform tag'} · {(item.video_file || item.embed_url) ? 'video' : 'image only'} · {item.published ? 'published' : 'hidden'}
          </p>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <form method="POST" action="/api/admin/ugc">
            <input type="hidden" name="intent" value="move" />
            <input type="hidden" name="id" value={item.id} />
            <input type="hidden" name="direction" value="up" />
            <button type="submit" class="admin-btn admin-btn-ghost" disabled={i === 0} aria-label="Move up">↑</button>
          </form>
          <form method="POST" action="/api/admin/ugc">
            <input type="hidden" name="intent" value="move" />
            <input type="hidden" name="id" value={item.id} />
            <input type="hidden" name="direction" value="down" />
            <button type="submit" class="admin-btn admin-btn-ghost" disabled={i === items.length - 1} aria-label="Move down">↓</button>
          </form>
          <a href={`/admin/ugc?edit=${item.id}`} class="admin-btn admin-btn-ghost">Edit</a>
          <form method="POST" action="/api/admin/ugc" onsubmit="return confirm('Delete this clip?')">
            <input type="hidden" name="intent" value="delete" />
            <input type="hidden" name="id" value={item.id} />
            <button type="submit" class="admin-btn admin-btn-danger">Delete</button>
          </form>
        </div>
      </div>
    ))}
  </section>
</AdminLayout>
