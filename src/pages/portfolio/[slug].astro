---
import Layout               from '../../layouts/Layout.astro';
import TestimonialsCarousel from '../../components/TestimonialsCarousel.astro';
import Footer                from '../../components/Footer.astro';
import { getPortfolioItemBySlug, getSettings, listTestimonialsForCaseStudy } from '../../lib/db';
import { DEFAULT_SETTINGS } from '../../lib/defaultSettings';

const { slug } = Astro.params;
const item = slug ? await getPortfolioItemBySlug(slug) : null;

if (!item || !item.published) {
  return Astro.redirect('/portfolio');
}

const [s, testimonials] = await Promise.all([
  getSettings(Object.keys(DEFAULT_SETTINGS)),
  listTestimonialsForCaseStudy(item.id),
]);
const settings = { ...DEFAULT_SETTINGS, ...s };

const descriptionParagraphs = item.description.split(/\n\s*\n/).map(p => p.trim()).filter(Boolean);
---

<Layout title={`${item.client_name || 'Personal project'} — ${item.title} — Spencer Lane`} description={item.caption}>
  <div class="pt-28 md:pt-36"></div>

  <section class="max-w-6xl mx-auto px-6 mb-12">
    <a href="/portfolio" class="font-sans text-xs tracking-[0.15em] uppercase text-f-gray hover:text-f-ink transition-colors inline-block mb-8">← Back to portfolio</a>

    <p class="font-sans text-xs tracking-[0.25em] uppercase text-f-gray mb-4 reveal">
      {item.client_name || 'Personal project'}
    </p>
    <h1 class="font-serif text-4xl md:text-5xl font-light text-f-ink leading-tight mb-4 reveal reveal-d1">
      {item.title}
    </h1>
    {item.caption && <p class="field-note inline-block reveal reveal-d1">{item.caption}</p>}
  </section>

  <!-- Cover media -->
  <section class="max-w-6xl mx-auto px-6 mb-12 reveal">
    {item.type === 'video' && item.embed_url ? (
      <div class="aspect-video w-full overflow-hidden bg-black">
        <iframe
          src={item.embed_url}
          class="w-full h-full"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
          title={item.title}
        ></iframe>
      </div>
    ) : (
      <div class="aspect-video w-full overflow-hidden bg-f-paper-warm">
        <img src={item.full_url || item.thumbnail} alt={item.title} class="w-full h-full object-cover" loading="lazy" />
      </div>
    )}
  </section>

  <!-- What I delivered -->
  {descriptionParagraphs.length > 0 && (
    <section class="max-w-3xl mx-auto px-6 mb-16">
      <p class="font-sans text-xs tracking-[0.25em] uppercase text-f-gray mb-5 reveal">What I delivered</p>
      <div class="space-y-5">
        {descriptionParagraphs.map(p => (
          <p class="font-sans text-base md:text-[17px] text-f-gray font-light leading-relaxed reveal">{p}</p>
        ))}
      </div>
    </section>
  )}

  <!-- Gallery (for gallery-type case studies) -->
  {item.type === 'gallery' && item.images.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 mb-16">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        {item.images.map(src => (
          <div class="aspect-square overflow-hidden bg-f-paper-warm">
            <img src={src} alt={item.title} class="w-full h-full object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    </section>
  )}

  <TestimonialsCarousel testimonials={testimonials} />

  <div class="max-w-6xl mx-auto px-6 py-16 md:py-24 text-center">
    <a
      href="/work-with-me"
      class="inline-block px-8 py-4 bg-f-ink text-f-white font-sans text-xs tracking-[0.15em] uppercase hover:bg-f-ink/80 transition-colors"
    >
      Work with me
    </a>
  </div>

  <Footer
    siteName={settings.site_name}
    email={settings.contact.email}
    phone={settings.contact.phone}
    phoneTel={settings.contact.phoneTel}
    tiktok={settings.socials.tiktok}
    instagram={settings.socials.instagram}
    youtube={settings.socials.youtube}
  />
</Layout>
