---
import Layout     from '../layouts/Layout.astro';
import WorkWithMe from '../components/WorkWithMe.astro';
import Footer     from '../components/Footer.astro';
import { getSettings } from '../lib/db';
import { DEFAULT_SETTINGS } from '../lib/defaultSettings';

const s = await getSettings(Object.keys(DEFAULT_SETTINGS));
const settings = { ...DEFAULT_SETTINGS, ...s };
---

<Layout
  title="Work With Me — Spencer Lane"
  description="Content creation, brand video, and local business video/photo packages from Spencer Lane."
>
  <div class="pt-28 md:pt-36"></div>

  <WorkWithMe
    intro={settings.work_with_me.intro}
    services={settings.work_with_me.services}
    email={settings.contact.email}
    phone={settings.contact.phone}
    phoneTel={settings.contact.phoneTel}
  />

  <Footer
    siteName={settings.site_name}
    email={settings.contact.email}
    phone={settings.contact.phone}
    phoneTel={settings.contact.phoneTel}
    tiktok={settings.socials.tiktok}
    instagram={settings.socials.instagram}
    youtube={settings.socials.youtube}
  />
</Layout>
