---
import FilmOpening  from '../components/FilmOpening.astro';
import { getSetting } from '../lib/db';
import { DEFAULT_SETTINGS } from '../lib/defaultSettings';

interface Props {
  title?:       string;
  description?: string;
}

const {
  title       = 'Spencer Lane — Filmmaker & Photographer',
  description = 'Filmmaker, photographer, and short-form creator based in Tyler, TX. 17, going somewhere.',
} = Astro.props;

const navVisibility = await getSetting('nav_visibility', DEFAULT_SETTINGS.nav_visibility);
const siteImage = await getSetting('site_image', DEFAULT_SETTINGS.site_image);
const absoluteImageUrl = new URL(siteImage, Astro.site).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const allNavItems = [
  { href: '/',              label: 'Home',         show: true },
  { href: '/about',         label: 'About',        show: navVisibility.about },
  { href: '/portfolio',     label: 'Portfolio',     show: navVisibility.portfolio },
  { href: '/shop',          label: 'Shop',          show: navVisibility.shop },
  { href: '/work-with-me',  label: 'Work With Me', show: navVisibility.workWithMe },
  { href: '/ugc',           label: 'UGC',          show: navVisibility.ugc },
];
const navItems = allNavItems.filter(item => item.show);
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const isHome = path === '/';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Favicon — a real photo of Spencer, editable from /admin/settings -->
  <link rel="icon" href={siteImage} />
  <link rel="apple-touch-icon" href={siteImage} />

  <!-- Open Graph / link-preview image — without this, apps like iMessage
       and Slack guess by scraping the page for any image, which was
       picking up a client's logo instead of a photo of Spencer. -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={absoluteImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteImageUrl} />

  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>

<!--
  body is position:relative — grain-wrap (absolute, first child) fills full
  page height and scrolls with the page like texture printed into the paper.
  CSS var --scene-bg drives section background transitions.
-->
<body
  class="bg-f-white text-f-ink font-sans antialiased"
  style="position:relative; background-color: var(--scene-bg, #E8DFD0); transition: background-color 0.8s ease;"
>

  <!-- Custom cursor dot -->
  <div id="custom-cursor" aria-hidden="true"></div>

  <!-- Film opening — first visit only -->
  <FilmOpening />

  <!-- Film grain — scrolls with page as first DOM child of body content -->
  <div class="grain-wrap" aria-hidden="true">
    <svg id="grain-svg" xmlns="http://www.w3.org/2000/svg" class="grain-svg">
      <filter id="film-grain" x="0%" y="0%" width="100%" height="100%">
        <feTurbulence
          id="grain-turb"
          type="fractalNoise"
          baseFrequency="0.72"
          numOctaves="4"
          stitchTiles="stitch"
          seed="1"
        />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <rect width="100%" height="100%" filter="url(#film-grain)" />
    </svg>
  </div>

  <!-- Fixed scratch/dust canvas overlay -->
  <canvas id="scratch-canvas" aria-hidden="true"></canvas>

  <!-- ── Navigation ── -->
  <nav id="main-nav" class:list={['film-nav', { 'film-nav--hero': isHome }]}>
    <!-- Metadata slate row -->
    <div class="film-slate hidden md:flex">
      <span class="tag"><span class="dot"></span>REC &middot; Tyler, TX</span>
      <span class="mid">Reel 028 &mdash; &ldquo;Going Anyway&rdquo;</span>
      <span class="tc">24.00 FPS &middot; 01:17:04</span>
    </div>

    <!-- Brand / links / contact row -->
    <div class="film-inner">
      <a href="/" class="film-brand" aria-label="Spencer Lane, home">
        <span class="name">Spencer Lane</span>
        <span class="role">Film &amp; Photography</span>
      </a>

      <ul class="film-links hidden md:flex">
        {navItems.map(item => (
          <li><a href={item.href} class={isActive(item.href) ? 'is-active' : ''}>{item.label}</a></li>
        ))}
      </ul>

      <div class="hidden md:block" aria-hidden="true"></div>

      <!-- Mobile hamburger -->
      <button id="mobile-menu-btn" class="md:hidden text-f-ink ml-auto" aria-label="Open menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="2" y1="5"  x2="20" y2="5"  />
          <line x1="2" y1="11" x2="20" y2="11" />
          <line x1="2" y1="17" x2="20" y2="17" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-f-border px-6 py-6" style="background:rgba(232,223,208,0.97);">
      <ul class="flex flex-col gap-5">
        {navItems.map(item => (
          <li><a href={item.href} class="mobile-nav-link text-xs tracking-[0.15em] uppercase font-medium text-f-gray">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Sprocket rail -->
    <div class="rail hidden md:flex" aria-hidden="true">
      <span class="hole"></span><span class="hole"></span><span class="hole"></span>
      <span class="track"></span>
      <span class="hole"></span><span class="hole"></span><span class="hole"></span>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <style is:global>
    html { scroll-behavior: smooth; }

    /* CSS var drives the scene background shifts */
    :root { --scene-bg: #E8DFD0; }

    /* ── Film Nav ── */
    .film-nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 50;
      background: rgba(232, 223, 208, 0.92);
      backdrop-filter: blur(14px) saturate(1.1);
      -webkit-backdrop-filter: blur(14px) saturate(1.1);
      border-bottom: 1px solid rgba(191, 179, 156, 0.35);
      transition: background 400ms ease, border-color 400ms ease;
    }
    .film-nav.scrolled {
      background: rgba(232, 223, 208, 0.96);
      border-bottom-color: rgba(191, 179, 156, 0.6);
    }

    /* ── Home page — nav floats over the hero video/image ──
       Flat, solid semi-dark bar (no fade-to-transparent — that edge was
       rendering as a visible seam against the playing video) with white
       text throughout for reliable contrast regardless of footage.
       Every selector here is written as ".film-nav.film-nav--hero ..."
       (not just ".film-nav--hero ...") to guarantee it outranks the
       equivalent base ".film-nav ..." rule regardless of which one
       happens to appear later in the file — with plain ".film-nav--hero",
       equal specificity + file order caused text/rail colors to silently
       lose to the base rules three separate times while this was built. */
    .film-nav.film-nav--hero {
      background: rgba(10, 9, 7, 0.55);
      border-bottom-color: rgba(255, 255, 255, 0.15);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .film-nav.film-nav--hero .film-slate { color: rgba(255,255,255,0.55); }
    .film-nav.film-nav--hero .film-slate .tag { color: rgba(255,255,255,0.8); }
    .film-nav.film-nav--hero .film-slate .dot { background: #fff; }
    .film-nav.film-nav--hero .film-slate .tc { color: rgba(255,255,255,0.92); }
    .film-nav.film-nav--hero .film-brand .name { color: #fff; }
    .film-nav.film-nav--hero .film-brand .role { color: rgba(255,255,255,0.75); }
    .film-nav.film-nav--hero .film-links a { color: rgba(255,255,255,0.8); }
    .film-nav.film-nav--hero .film-links a::before { color: rgba(255,255,255,0.55); }
    .film-nav.film-nav--hero .film-links a::after { background: #fff; }
    .film-nav.film-nav--hero .film-links a:hover,
    .film-nav.film-nav--hero .film-links a.is-active { color: #fff; }
    .film-nav.film-nav--hero #mobile-menu-btn { color: #fff; }
    .film-nav.film-nav--hero .rail { display: none; }

    /* Once scrolled past the hero, fall back to the normal solid nav */
    .film-nav.film-nav--hero.scrolled {
      background: rgba(232, 223, 208, 0.96);
      border-bottom-color: rgba(191, 179, 156, 0.6);
      backdrop-filter: blur(14px) saturate(1.1);
      -webkit-backdrop-filter: blur(14px) saturate(1.1);
    }
    .film-nav.film-nav--hero.scrolled .film-slate { color: #9A9186; }
    .film-nav.film-nav--hero.scrolled .film-slate .tag { color: #6B6357; }
    .film-nav.film-nav--hero.scrolled .film-slate .dot { background: #1F1C18; }
    .film-nav.film-nav--hero.scrolled .film-slate .tc { color: #1F1C18; }
    .film-nav.film-nav--hero.scrolled .film-brand .name { color: #1F1C18; }
    .film-nav.film-nav--hero.scrolled .film-brand .role { color: #6B6357; }
    .film-nav.film-nav--hero.scrolled .film-links a { color: #6B6357; }
    .film-nav.film-nav--hero.scrolled .film-links a::before { color: #9A9186; }
    .film-nav.film-nav--hero.scrolled .film-links a::after { background: #1F1C18; }
    .film-nav.film-nav--hero.scrolled .film-links a:hover,
    .film-nav.film-nav--hero.scrolled .film-links a.is-active { color: #1F1C18; }
    .film-nav.film-nav--hero.scrolled #mobile-menu-btn { color: #1F1C18; }
    .film-nav.film-nav--hero.scrolled .rail { display: flex; }

    /* Slate metadata row — desktop only, matches the "hidden md:flex" on the element */
    @media (min-width: 768px) {
      .film-nav .film-slate { display: flex; }
    }
    .film-nav .film-slate {
      justify-content: space-between;
      align-items: center;
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 9.5px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: #9A9186;
      padding: 10px 40px;
      max-width: 1152px;
      margin: 0 auto;
    }
    .film-nav .film-slate .tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #6B6357;
    }
    .film-nav .film-slate .dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #1F1C18;
      flex-shrink: 0;
      animation: pulse-dot 2.2s ease-in-out infinite;
    }
    @keyframes pulse-dot { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }
    .film-nav .film-slate .mid { color: #6B6357; letter-spacing: 0.24em; }
    .film-nav .film-slate .tc  { font-variant-numeric: tabular-nums; color: #1F1C18; }

    /* Inner brand / links / contact row */
    .film-nav .film-inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: end;
      padding: 16px 40px 14px;
      gap: 40px;
      max-width: 1152px;
      margin: 0 auto;
      transition: padding 400ms ease;
    }
    .film-nav.scrolled .film-inner { padding: 10px 40px; }
    @media (max-width: 767px) {
      .film-nav .film-inner {
        grid-template-columns: 1fr auto;
        padding: 14px 20px;
      }
    }

    /* Brand */
    .film-nav .film-brand {
      display: flex;
      flex-direction: column;
      gap: 2px;
      line-height: 1;
      white-space: nowrap;
      text-decoration: none;
    }
    .film-nav .film-brand .name {
      font-family: 'Fraunces', Georgia, serif;
      font-weight: 300;
      font-style: italic;
      font-size: 28px;
      color: #1F1C18;
      letter-spacing: -0.015em;
    }
    .film-nav .film-brand .role {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: #6B6357;
      margin-top: 6px;
    }
    @media (max-width: 767px) {
      .film-nav .film-brand .name { font-size: 22px; }
      .film-nav .film-brand .role { display: none; }
    }

    /* Nav links (center) — desktop only, matches the "hidden md:flex" on the element */
    @media (min-width: 768px) {
      .film-nav .film-links { display: flex; }
    }
    .film-nav .film-links {
      justify-self: center;
      list-style: none;
      margin: 0;
      padding: 0;
      justify-content: center;
      align-items: baseline;
      gap: 32px;
      counter-reset: fnav;
    }
    .film-nav .film-links li { counter-increment: fnav; }
    .film-nav .film-links a {
      position: relative;
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #6B6357;
      text-decoration: none;
      padding: 4px 0;
      transition: color 320ms ease;
    }
    .film-nav .film-links a::before {
      content: "0" counter(fnav);
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 9px;
      color: #9A9186;
      margin-right: 10px;
      letter-spacing: 0.1em;
      vertical-align: 2px;
    }
    .film-nav .film-links a::after {
      content: "";
      position: absolute;
      left: 0; right: 0; bottom: -2px;
      height: 1px;
      background: #1F1C18;
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 520ms cubic-bezier(.2,.6,.2,1);
    }
    .film-nav .film-links a:hover,
    .film-nav .film-links a.is-active { color: #1F1C18; }
    .film-nav .film-links a:hover::after,
    .film-nav .film-links a.is-active::after { transform: scaleX(1); }

    /* Sprocket rail — desktop only, matches the "hidden md:flex" on the element */
    @media (min-width: 768px) {
      .film-nav .rail { display: flex; }
    }
    .film-nav .rail {
      align-items: stretch;
      height: 16px;
      border-top: 1px solid #BFB39C;
      border-bottom: 1px solid #BFB39C;
      background: #EEE6D6;
      gap: 10px;
      padding: 3px 40px;
      overflow: hidden;
    }
    .film-nav .rail .hole {
      width: 14px;
      height: 100%;
      border: 1px solid #A89B84;
      border-radius: 2px;
      background: #E8DFD0;
      flex-shrink: 0;
    }
    .film-nav .rail .track {
      flex: 1;
      align-self: center;
      height: 1px;
      background: repeating-linear-gradient(
        90deg, #BFB39C 0 1px, transparent 1px 36px
      );
    }

    /* Hide default cursor — custom dot rendered instead */
    * { cursor: none !important; }

    /* ── Custom cursor dot ── */
    #custom-cursor {
      position: fixed;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #6B6357;
      mix-blend-mode: difference;
      pointer-events: none;
      z-index: 9999;
      top: 0; left: 0;
      transform: translate(-50%, -50%);
      transition: width 0.18s ease, height 0.18s ease, opacity 0.2s ease;
      opacity: 0;
    }
    #custom-cursor.visible { opacity: 1; }
    #custom-cursor.hovered { width: 22px; height: 22px; }

    /* ── Film grain ── */
    .grain-wrap {
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      mix-blend-mode: multiply;
      animation: grain-flicker 1.6s steps(4, end) infinite;
    }
    .grain-svg { width: 100%; height: 100%; display: block; }

    @keyframes grain-flicker {
      0%   { opacity: 0.18; }
      25%  { opacity: 0.24; }
      50%  { opacity: 0.20; }
      75%  { opacity: 0.23; }
      100% { opacity: 0.18; }
    }

    /* ── Scratch/dust canvas ── */
    #scratch-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 15;
    }

    /* ── Image color grade — Kodak Portra-adjacent ── */
    img {
      filter: contrast(0.91) saturate(0.82) sepia(0.08) brightness(0.97);
      opacity: 0;
      transition: opacity 0.9s ease;
    }
    img.img-loaded { opacity: 1; }

    /* Film exposure effect on work grid images */
    .work-img {
      filter: contrast(0.91) saturate(0.82) sepia(0.08) brightness(1.55) !important;
      transition: filter 1.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.9s ease,
                  transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }
    .work-img.in-view {
      filter: contrast(0.91) saturate(0.82) sepia(0.08) brightness(0.97) !important;
    }
    .work-item:hover .work-img {
      transform: rotate(0.6deg) scale(1.03) !important;
    }

    /* Lightbox images: bypass fade-in and grade */
    #lightbox img {
      opacity: 1 !important;
      transition: none !important;
      filter: none !important;
    }

    /* ── Typography ── */
    body { line-height: 1.7; }
    h1, h2, h3, h4 {
      letter-spacing: -0.01em;
      color: #1F1C18;
    }

    /* ── Scroll reveal — slide up + fade ── */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .reveal-d1 { transition-delay: 0.10s; }
    .reveal-d2 { transition-delay: 0.22s; }
    .reveal-d3 { transition-delay: 0.34s; }
    .reveal-d4 { transition-delay: 0.46s; }

    /* ── Nav scrolled — handled by .film-nav.scrolled above ── */

    /* ── Lightbox ── */
    #lightbox { transition: opacity 0.25s ease; }
    #lightbox.hidden { opacity: 0; }

    /* ── Film tick section dividers ── */
    .film-tick {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 5px;
      opacity: 0.4;
    }
    .film-tick span {
      display: block;
      width: 8px;
      height: 11px;
      border: 1px solid #BFB39C;
      border-radius: 1.5px;
    }

    /* ── Underline draw animation (hero) ── */
    .hero-underline-path {
      stroke-dasharray: 500;
      stroke-dashoffset: 500;
      animation: draw-line 1.4s cubic-bezier(0.16, 1, 0.3, 1) 1s forwards;
    }
    @keyframes draw-line {
      to { stroke-dashoffset: 0; }
    }

    /* ── Field notes ── */
    .field-note {
      font-family: 'Caveat', cursive;
      font-size: 15px;
      color: #5C5840;
      opacity: 0.7;
      line-height: 1.4;
    }

    /* Olive scribble underline on section headings */
    .scribble-head {
      position: relative;
      display: inline-block;
    }
    .scribble-head::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 100%;
      height: 2px;
      background: #5C5840;
      opacity: 0.25;
      border-radius: 1px;
    }

    @media (prefers-reduced-motion: reduce) {
      .grain-wrap { animation: none; opacity: 0.20; }
      .reveal { transition: opacity 0.6s ease !important; transform: none !important; }
      .reveal.visible { transform: none !important; }
      .hero-underline-path { animation: none; stroke-dashoffset: 0; }
    }
  </style>

  <script>
    // ── Custom cursor ──
    const cursor = document.getElementById('custom-cursor');
    if (cursor) {
      document.addEventListener('mousemove', e => {
        cursor.style.left = e.clientX + 'px';
        cursor.style.top  = e.clientY + 'px';
        cursor.classList.add('visible');
      }, { passive: true });
      document.querySelectorAll('a, button').forEach(el => {
        el.addEventListener('mouseenter', () => cursor.classList.add('hovered'));
        el.addEventListener('mouseleave', () => cursor.classList.remove('hovered'));
      });
    }

    // ── Film grain — seed animation at 8fps ──
    const grainTurb = document.getElementById('grain-turb');
    const grainWrap = document.querySelector<HTMLElement>('.grain-wrap');

    function syncGrainHeight() {
      if (grainWrap) {
        grainWrap.style.height = Math.max(
          document.documentElement.scrollHeight,
          document.body.scrollHeight,
          window.innerHeight
        ) + 'px';
      }
    }
    syncGrainHeight();
    window.addEventListener('resize', syncGrainHeight, { passive: true });
    window.addEventListener('load', syncGrainHeight);
    setTimeout(syncGrainHeight, 1000);

    const GRAIN_INTERVAL = 1000 / 8;
    let lastGrainTime = 0;
    function tickGrain(ts: number) {
      requestAnimationFrame(tickGrain);
      if (ts - lastGrainTime < GRAIN_INTERVAL) return;
      lastGrainTime = ts;
      if (grainTurb) grainTurb.setAttribute('seed', String(Math.floor(Math.random() * 9999)));
    }
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      requestAnimationFrame(tickGrain);
    }

    // ── Scratch & dust canvas ──
    const canvas = document.getElementById('scratch-canvas') as HTMLCanvasElement;
    const ctx    = canvas?.getContext('2d');
    function drawFilmDamage() {
      if (!canvas || !ctx) return;
      canvas.width  = window.innerWidth;
      canvas.height = window.innerHeight;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (let i = 0; i < 2; i++) {
        const x = i === 0
          ? canvas.width * (0.12 + Math.random() * 0.06)
          : canvas.width * (0.62 + Math.random() * 0.08);
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x + (Math.random() - 0.5) * 2, canvas.height);
        ctx.strokeStyle = `rgba(255,252,245,${0.022 + Math.random() * 0.018})`;
        ctx.lineWidth   = 0.6 + Math.random() * 0.4;
        ctx.stroke();
      }
      for (let i = 0; i < 6; i++) {
        ctx.beginPath();
        ctx.arc(Math.random() * canvas.width, Math.random() * canvas.height, 0.5 + Math.random() * 1.2, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,252,245,${0.04 + Math.random() * 0.04})`;
        ctx.fill();
      }
    }
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      drawFilmDamage();
      setInterval(drawFilmDamage, 3200);
      window.addEventListener('resize', drawFilmDamage, { passive: true });
    }

    // ── Image fade-in ──
    document.querySelectorAll<HTMLImageElement>('img').forEach(img => {
      const mark = () => img.classList.add('img-loaded');
      if (img.complete && img.naturalWidth > 0) mark();
      else { img.addEventListener('load', mark); img.addEventListener('error', mark); }
    });

    // ── Nav scrolled ──
    // On the home page the nav floats transparently over the full-height
    // hero video — keep it that way for the whole hero, not just the first
    // 60px, and only switch to the solid nav once past it.
    const nav = document.getElementById('main-nav');
    const isHeroNav = nav?.classList.contains('film-nav--hero');
    window.addEventListener('scroll', () => {
      const threshold = isHeroNav ? window.innerHeight - 80 : 60;
      nav?.classList.toggle('scrolled', window.scrollY > threshold);
    }, { passive: true });

    // ── Mobile menu ──
    const mobileBtn  = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileBtn?.addEventListener('click', () => {
      const open = mobileMenu?.classList.toggle('hidden') === false;
      mobileBtn.setAttribute('aria-expanded', String(open));
    });
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => mobileMenu?.classList.add('hidden'));
    });

    // ── Scroll reveal ──
    const ro = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('visible'); ro.unobserve(e.target); }
      }),
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal').forEach(el => ro.observe(el));

    // ── Work image film exposure reveal ──
    const imgRo = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in-view'); imgRo.unobserve(e.target); }
      }),
      { threshold: 0.15 }
    );
    document.querySelectorAll('.work-img').forEach(img => imgRo.observe(img));

    // ── Scene background shifts + grain pulse ──
    // Each section has a subtle mood color that transitions smoothly.
    const sceneBg: Record<string, string> = {
      'hero':         '#E8DFD0',
      'about':        '#EEE6D6',
      'work-with-me': '#E8DFD0',
    };

    let grainPulseTimer: ReturnType<typeof setTimeout> | null = null;

    function pulseGrain() {
      if (!grainWrap) return;
      grainWrap.style.opacity = '0.30';
      if (grainPulseTimer) clearTimeout(grainPulseTimer);
      grainPulseTimer = setTimeout(() => {
        if (grainWrap) grainWrap.style.opacity = '';
      }, 620);
    }

    let currentScene = '';
    const sceneRo = new IntersectionObserver(
      entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            const id = (e.target as HTMLElement).id;
            if (id && id !== currentScene && sceneBg[id]) {
              currentScene = id;
              document.body.style.setProperty('--scene-bg', sceneBg[id]);
              if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) pulseGrain();
            }
          }
        });
      },
      { threshold: 0.35 }
    );
    ['hero', 'about', 'work-with-me'].forEach(id => {
      const el = document.getElementById(id);
      if (el) sceneRo.observe(el);
    });
  </script>

</body>
</html>
