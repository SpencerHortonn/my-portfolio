---
import TreeSpine    from '../components/TreeSpine.astro';
import FilmOpening  from '../components/FilmOpening.astro';

interface Props {
  title?:       string;
  description?: string;
}

const {
  title       = 'Spencer Lane — Filmmaker & Photographer',
  description = 'Filmmaker, photographer, and short-form creator based in Tyler, TX. 17, going somewhere.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=Inter:wght@300;400;500&display=swap"
    rel="stylesheet"
  />
</head>

<!--
  body is position:relative — grain-wrap (absolute, first child) fills full
  page height and scrolls with the page like texture printed into the paper.
  CSS var --scene-bg drives section background transitions.
-->
<body
  class="bg-f-white text-f-ink font-sans antialiased"
  style="position:relative; background-color: var(--scene-bg, #E5DCC8); transition: background-color 0.8s ease;"
>

  <!-- Custom cursor dot -->
  <div id="custom-cursor" aria-hidden="true"></div>

  <!-- Film opening — first visit only -->
  <FilmOpening />

  <!-- Film grain — scrolls with page as first DOM child of body content -->
  <div class="grain-wrap" aria-hidden="true">
    <svg id="grain-svg" xmlns="http://www.w3.org/2000/svg" class="grain-svg">
      <filter id="film-grain" x="0%" y="0%" width="100%" height="100%">
        <feTurbulence
          id="grain-turb"
          type="fractalNoise"
          baseFrequency="0.72"
          numOctaves="4"
          stitchTiles="stitch"
          seed="1"
        />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <rect width="100%" height="100%" filter="url(#film-grain)" />
    </svg>
  </div>

  <!-- Fixed scratch/dust canvas overlay -->
  <canvas id="scratch-canvas" aria-hidden="true"></canvas>

  <!-- Tree spine navigation — desktop left, mobile right vine -->
  <TreeSpine />

  <!-- ── Navigation ── -->
  <nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
    <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">
      <a href="#hero" class="font-serif italic text-lg text-f-ink hover:opacity-60 transition-opacity">
        Spencer Lane
      </a>

      <ul class="hidden md:flex items-center gap-8">
        <li><a href="#work"         class="nav-link text-xs tracking-[0.15em] uppercase font-medium text-f-gray hover:text-f-ink transition-colors">Work</a></li>
        <li><a href="#switzerland"  class="nav-link text-xs tracking-[0.15em] uppercase font-medium text-f-gray hover:text-f-ink transition-colors">Switzerland</a></li>
        <li><a href="#work-with-me" class="nav-link text-xs tracking-[0.15em] uppercase font-medium text-f-gray hover:text-f-ink transition-colors">Collab</a></li>
        <li>
          <a
            href="mailto:spencerhortonmedia@gmail.com"
            class="text-xs tracking-[0.15em] uppercase font-medium px-4 py-2 border border-f-ink text-f-ink hover:bg-f-ink hover:text-f-white transition-all duration-200"
          >
            Contact
          </a>
        </li>
      </ul>

      <button id="mobile-menu-btn" class="md:hidden text-f-ink" aria-label="Open menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="2" y1="5"  x2="20" y2="5"  />
          <line x1="2" y1="11" x2="20" y2="11" />
          <line x1="2" y1="17" x2="20" y2="17" />
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden md:hidden border-t border-f-border px-6 py-6" style="background:rgba(229,220,200,0.97);">
      <ul class="flex flex-col gap-5">
        <li><a href="#work"         class="mobile-nav-link text-xs tracking-[0.15em] uppercase font-medium text-f-gray">Work</a></li>
        <li><a href="#switzerland"  class="mobile-nav-link text-xs tracking-[0.15em] uppercase font-medium text-f-gray">Switzerland</a></li>
        <li><a href="#work-with-me" class="mobile-nav-link text-xs tracking-[0.15em] uppercase font-medium text-f-gray">Collab</a></li>
        <li><a href="mailto:spencerhortonmedia@gmail.com" class="text-xs tracking-[0.15em] uppercase font-medium text-f-gray">Contact</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <style is:global>
    html { scroll-behavior: smooth; }

    /* CSS var drives the scene background shifts */
    :root { --scene-bg: #E5DCC8; }

    /* Hide default cursor — custom dot rendered instead */
    * { cursor: none !important; }

    /* ── Custom cursor dot ── */
    #custom-cursor {
      position: fixed;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #6B6357;
      mix-blend-mode: difference;
      pointer-events: none;
      z-index: 9999;
      top: 0; left: 0;
      transform: translate(-50%, -50%);
      transition: width 0.18s ease, height 0.18s ease, opacity 0.2s ease;
      opacity: 0;
    }
    #custom-cursor.visible { opacity: 1; }
    #custom-cursor.hovered { width: 22px; height: 22px; }

    /* ── Film grain ── */
    .grain-wrap {
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      mix-blend-mode: multiply;
      animation: grain-flicker 1.6s steps(4, end) infinite;
    }
    .grain-svg { width: 100%; height: 100%; display: block; }

    @keyframes grain-flicker {
      0%   { opacity: 0.18; }
      25%  { opacity: 0.24; }
      50%  { opacity: 0.20; }
      75%  { opacity: 0.23; }
      100% { opacity: 0.18; }
    }

    /* ── Scratch/dust canvas ── */
    #scratch-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 15;
    }

    /* ── Image color grade — Kodak Portra-adjacent ── */
    img {
      filter: contrast(0.91) saturate(0.82) sepia(0.08) brightness(0.97);
      opacity: 0;
      transition: opacity 0.9s ease;
    }
    img.img-loaded { opacity: 1; }

    /* Film exposure effect on work grid images */
    .work-img {
      filter: contrast(0.91) saturate(0.82) sepia(0.08) brightness(1.55) !important;
      transition: filter 1.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.9s ease,
                  transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }
    .work-img.in-view {
      filter: contrast(0.91) saturate(0.82) sepia(0.08) brightness(0.97) !important;
    }
    .work-item:hover .work-img {
      transform: rotate(0.6deg) scale(1.03) !important;
    }

    /* Lightbox images: bypass fade-in and grade */
    #lightbox img {
      opacity: 1 !important;
      transition: none !important;
      filter: none !important;
    }

    /* ── Typography ── */
    body { line-height: 1.7; }
    h1, h2, h3, h4 {
      letter-spacing: -0.01em;
      color: #1F1C18;
    }

    /* ── Scroll reveal — slide up + fade ── */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .reveal-d1 { transition-delay: 0.10s; }
    .reveal-d2 { transition-delay: 0.22s; }
    .reveal-d3 { transition-delay: 0.34s; }
    .reveal-d4 { transition-delay: 0.46s; }

    /* ── Nav scrolled ── */
    #main-nav.scrolled {
      background: rgba(229, 220, 200, 0.94);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(191, 179, 156, 0.5);
    }

    /* ── Lightbox ── */
    #lightbox { transition: opacity 0.25s ease; }
    #lightbox.hidden { opacity: 0; }

    /* ── Film tick section dividers ── */
    .film-tick {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 5px;
      opacity: 0.4;
    }
    .film-tick span {
      display: block;
      width: 8px;
      height: 11px;
      border: 1px solid #BFB39C;
      border-radius: 1.5px;
    }

    /* ── Underline draw animation (hero) ── */
    .hero-underline-path {
      stroke-dasharray: 500;
      stroke-dashoffset: 500;
      animation: draw-line 1.4s cubic-bezier(0.16, 1, 0.3, 1) 1s forwards;
    }
    @keyframes draw-line {
      to { stroke-dashoffset: 0; }
    }

    /* ── Field notes ── */
    .field-note {
      font-family: 'Caveat', cursive;
      font-size: 15px;
      color: #5C5840;
      opacity: 0.7;
      line-height: 1.4;
    }

    /* Olive scribble underline on section headings */
    .scribble-head {
      position: relative;
      display: inline-block;
    }
    .scribble-head::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 100%;
      height: 2px;
      background: #5C5840;
      opacity: 0.25;
      border-radius: 1px;
    }

    @media (prefers-reduced-motion: reduce) {
      .grain-wrap { animation: none; opacity: 0.20; }
      .reveal { transition: opacity 0.6s ease !important; transform: none !important; }
      .reveal.visible { transform: none !important; }
      .hero-underline-path { animation: none; stroke-dashoffset: 0; }
    }
  </style>

  <script>
    // ── Custom cursor ──
    const cursor = document.getElementById('custom-cursor');
    if (cursor) {
      document.addEventListener('mousemove', e => {
        cursor.style.left = e.clientX + 'px';
        cursor.style.top  = e.clientY + 'px';
        cursor.classList.add('visible');
      }, { passive: true });
      document.querySelectorAll('a, button').forEach(el => {
        el.addEventListener('mouseenter', () => cursor.classList.add('hovered'));
        el.addEventListener('mouseleave', () => cursor.classList.remove('hovered'));
      });
    }

    // ── Film grain — seed animation at 8fps ──
    const grainTurb = document.getElementById('grain-turb');
    const grainWrap = document.querySelector<HTMLElement>('.grain-wrap');

    function syncGrainHeight() {
      if (grainWrap) {
        grainWrap.style.height = Math.max(
          document.documentElement.scrollHeight,
          document.body.scrollHeight,
          window.innerHeight
        ) + 'px';
      }
    }
    syncGrainHeight();
    window.addEventListener('resize', syncGrainHeight, { passive: true });
    window.addEventListener('load', syncGrainHeight);
    setTimeout(syncGrainHeight, 1000);

    const GRAIN_INTERVAL = 1000 / 8;
    let lastGrainTime = 0;
    function tickGrain(ts: number) {
      requestAnimationFrame(tickGrain);
      if (ts - lastGrainTime < GRAIN_INTERVAL) return;
      lastGrainTime = ts;
      if (grainTurb) grainTurb.setAttribute('seed', String(Math.floor(Math.random() * 9999)));
    }
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      requestAnimationFrame(tickGrain);
    }

    // ── Scratch & dust canvas ──
    const canvas = document.getElementById('scratch-canvas') as HTMLCanvasElement;
    const ctx    = canvas?.getContext('2d');
    function drawFilmDamage() {
      if (!canvas || !ctx) return;
      canvas.width  = window.innerWidth;
      canvas.height = window.innerHeight;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (let i = 0; i < 2; i++) {
        const x = i === 0
          ? canvas.width * (0.12 + Math.random() * 0.06)
          : canvas.width * (0.62 + Math.random() * 0.08);
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x + (Math.random() - 0.5) * 2, canvas.height);
        ctx.strokeStyle = `rgba(255,252,245,${0.022 + Math.random() * 0.018})`;
        ctx.lineWidth   = 0.6 + Math.random() * 0.4;
        ctx.stroke();
      }
      for (let i = 0; i < 6; i++) {
        ctx.beginPath();
        ctx.arc(Math.random() * canvas.width, Math.random() * canvas.height, 0.5 + Math.random() * 1.2, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,252,245,${0.04 + Math.random() * 0.04})`;
        ctx.fill();
      }
    }
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      drawFilmDamage();
      setInterval(drawFilmDamage, 3200);
      window.addEventListener('resize', drawFilmDamage, { passive: true });
    }

    // ── Image fade-in ──
    document.querySelectorAll<HTMLImageElement>('img').forEach(img => {
      const mark = () => img.classList.add('img-loaded');
      if (img.complete && img.naturalWidth > 0) mark();
      else { img.addEventListener('load', mark); img.addEventListener('error', mark); }
    });

    // ── Nav scrolled ──
    const nav = document.getElementById('main-nav');
    window.addEventListener('scroll', () => {
      nav?.classList.toggle('scrolled', window.scrollY > 60);
    }, { passive: true });

    // ── Mobile menu ──
    const mobileBtn  = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileBtn?.addEventListener('click', () => {
      const open = mobileMenu?.classList.toggle('hidden') === false;
      mobileBtn.setAttribute('aria-expanded', String(open));
    });
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => mobileMenu?.classList.add('hidden'));
    });

    // ── Scroll reveal ──
    const ro = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('visible'); ro.unobserve(e.target); }
      }),
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal').forEach(el => ro.observe(el));

    // ── Work image film exposure reveal ──
    const imgRo = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in-view'); imgRo.unobserve(e.target); }
      }),
      { threshold: 0.15 }
    );
    document.querySelectorAll('.work-img').forEach(img => imgRo.observe(img));

    // ── Scene background shifts + grain pulse ──
    // Each section has a subtle mood color that transitions smoothly.
    const sceneBg: Record<string, string> = {
      'hero':         '#E5DCC8',
      'about':        '#E8DCC4',
      'work':         '#E5DCC8',
      'switzerland':  '#E2DCCE',
      'work-with-me': '#E5DCC8',
    };

    let grainPulseTimer: ReturnType<typeof setTimeout> | null = null;

    function pulseGrain() {
      if (!grainWrap) return;
      grainWrap.style.opacity = '0.30';
      if (grainPulseTimer) clearTimeout(grainPulseTimer);
      grainPulseTimer = setTimeout(() => {
        if (grainWrap) grainWrap.style.opacity = '';
      }, 620);
    }

    let currentScene = '';
    const sceneRo = new IntersectionObserver(
      entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            const id = (e.target as HTMLElement).id;
            if (id && id !== currentScene && sceneBg[id]) {
              currentScene = id;
              document.body.style.setProperty('--scene-bg', sceneBg[id]);
              if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) pulseGrain();
            }
          }
        });
      },
      { threshold: 0.35 }
    );
    ['hero', 'about', 'work', 'switzerland', 'work-with-me'].forEach(id => {
      const el = document.getElementById(id);
      if (el) sceneRo.observe(el);
    });
  </script>

</body>
</html>
