---
interface Props {
  title?:       string;
  description?: string;
}

const {
  title       = 'Spencer Lane — Filmmaker & Photographer',
  description = 'Filmmaker, photographer, and short-form creator based in Tyler, TX. 17, going somewhere.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400&family=Inter:wght@300;400;500&display=swap"
    rel="stylesheet"
  />
</head>

<!--
  body is position:relative so the absolute grain-wrap can fill the full page height.
  The grain-wrap is the FIRST child — no z-index needed; later DOM siblings paint
  on top of it naturally. This means the grain scrolls with the page like
  physical texture on a strip of film, not a floating overlay.
-->
<body class="bg-f-white text-f-ink font-sans antialiased" style="position:relative;">

  <!--
    Film grain — position:absolute, covers the full document height.
    JS updates its height whenever the page grows (images loading, etc.).
    seed is mutated at ~8fps so the grain texture changes every frame like
    real film grain, but because it scrolls WITH the page it feels printed
    into the paper rather than hovering above it.
    mix-blend-mode:multiply darkens the warm beige in a grain pattern.
    No position jitter needed — natural scroll movement provides the motion.
  -->
  <div class="grain-wrap" aria-hidden="true">
    <svg id="grain-svg" xmlns="http://www.w3.org/2000/svg" class="grain-svg">
      <filter id="film-grain" x="0%" y="0%" width="100%" height="100%">
        <feTurbulence
          id="grain-turb"
          type="fractalNoise"
          baseFrequency="0.72"
          numOctaves="4"
          stitchTiles="stitch"
          seed="1"
        />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <rect width="100%" height="100%" filter="url(#film-grain)" />
    </svg>
  </div>

  <!-- ── Navigation ── -->
  <nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
    <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">
      <a href="#hero" class="font-serif text-lg text-f-ink tracking-tight hover:opacity-60 transition-opacity">
        Spencer Lane
      </a>

      <ul class="hidden md:flex items-center gap-8">
        <li><a href="#work"         class="nav-link text-xs tracking-[0.15em] uppercase font-medium text-f-gray hover:text-f-ink transition-colors">Work</a></li>
        <li><a href="#switzerland"  class="nav-link text-xs tracking-[0.15em] uppercase font-medium text-f-gray hover:text-f-ink transition-colors">Switzerland</a></li>
        <li><a href="#work-with-me" class="nav-link text-xs tracking-[0.15em] uppercase font-medium text-f-gray hover:text-f-ink transition-colors">Collab</a></li>
        <li>
          <a
            href="mailto:spencerhortonmedia@gmail.com"
            class="text-xs tracking-[0.15em] uppercase font-medium px-4 py-2 border border-f-ink text-f-ink hover:bg-f-ink hover:text-f-white transition-all duration-200"
          >
            Contact
          </a>
        </li>
      </ul>

      <button id="mobile-menu-btn" class="md:hidden text-f-ink" aria-label="Open menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="2" y1="5"  x2="20" y2="5"  />
          <line x1="2" y1="11" x2="20" y2="11" />
          <line x1="2" y1="17" x2="20" y2="17" />
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden md:hidden border-t border-f-border px-6 py-6" style="background:rgba(229,220,200,0.97);">
      <ul class="flex flex-col gap-5">
        <li><a href="#work"         class="mobile-nav-link text-xs tracking-[0.15em] uppercase font-medium text-f-gray">Work</a></li>
        <li><a href="#switzerland"  class="mobile-nav-link text-xs tracking-[0.15em] uppercase font-medium text-f-gray">Switzerland</a></li>
        <li><a href="#work-with-me" class="mobile-nav-link text-xs tracking-[0.15em] uppercase font-medium text-f-gray">Collab</a></li>
        <li><a href="mailto:spencerhortonmedia@gmail.com" class="text-xs tracking-[0.15em] uppercase font-medium text-f-gray">Contact</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <style is:global>
    html { scroll-behavior: smooth; }

    /* ── Single warm-paper background across the whole page ── */
    body {
      background-color: #E5DCC8;
      color: #2B2825;
    }

    /* ── Film grain — scrolls with page, not fixed above it ──
       position:absolute + first DOM child = sits below all content
       in natural stacking order. No z-index needed.
       JS sets height = full document scrollHeight so it covers
       every pixel of the page. Seed animation gives the jitter.   */
    .grain-wrap {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%; /* JS overrides this with scrollHeight */
      pointer-events: none;
      opacity: 0.20;
      mix-blend-mode: multiply;
    }
    .grain-svg { width: 100%; height: 100%; display: block; }

    /* ── Image color grade — Kodak Portra-adjacent ── */
    img {
      filter: contrast(0.91) saturate(0.82) sepia(0.08) brightness(0.97);
      opacity: 0;
      transition: opacity 0.9s ease;
    }
    img.img-loaded { opacity: 1; }

    /* Lightbox images: bypass fade-in and grade (injected dynamically) */
    #lightbox img {
      opacity: 1 !important;
      transition: none !important;
      filter: none !important;
    }

    /* ── Typography ── */
    body { line-height: 1.7; }
    h1, h2, h3, h4 {
      letter-spacing: -0.01em;
      color: #1F1C18;
    }

    /* ── Scroll reveal — pure fade, no slide ── */
    .reveal { opacity: 0; transition: opacity 1s ease; }
    .reveal.visible { opacity: 1; }
    .reveal-d1 { transition-delay: 0.12s; }
    .reveal-d2 { transition-delay: 0.24s; }
    .reveal-d3 { transition-delay: 0.36s; }
    .reveal-d4 { transition-delay: 0.48s; }

    /* ── Nav scrolled — matches the warm-paper background ── */
    #main-nav.scrolled {
      background: rgba(229, 220, 200, 0.94);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(191, 179, 156, 0.5);
    }

    /* ── Lightbox ── */
    #lightbox { transition: opacity 0.25s ease; }
    #lightbox.hidden { opacity: 0; }
  </style>

  <script>
    // ── Film grain — seed animation at 8fps ──
    // Only seed changes; no position jitter (grain scrolls naturally with page).
    const grainTurb = document.getElementById('grain-turb');
    const grainWrap = document.querySelector<HTMLElement>('.grain-wrap');

    // Keep grain height = full page so no gap appears at bottom when scrolling
    function syncGrainHeight() {
      if (grainWrap) {
        grainWrap.style.height = Math.max(
          document.documentElement.scrollHeight,
          document.body.scrollHeight,
          window.innerHeight
        ) + 'px';
      }
    }
    syncGrainHeight();
    window.addEventListener('resize', syncGrainHeight, { passive: true });
    window.addEventListener('load',   syncGrainHeight);
    // Re-sync 1 s after load to catch lazy images that expanded the page
    setTimeout(syncGrainHeight, 1000);

    const GRAIN_INTERVAL = 1000 / 8; // 8 fps
    let lastGrainTime = 0;

    function tickGrain(ts: number) {
      requestAnimationFrame(tickGrain);
      if (ts - lastGrainTime < GRAIN_INTERVAL) return;
      lastGrainTime = ts;
      if (grainTurb) grainTurb.setAttribute('seed', String(Math.floor(Math.random() * 9999)));
    }

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      requestAnimationFrame(tickGrain);
    }

    // ── Image fade-in ──
    document.querySelectorAll<HTMLImageElement>('img').forEach(img => {
      const mark = () => img.classList.add('img-loaded');
      if (img.complete && img.naturalWidth > 0) mark();
      else {
        img.addEventListener('load',  mark);
        img.addEventListener('error', mark);
      }
    });

    // ── Nav scrolled ──
    const nav = document.getElementById('main-nav');
    window.addEventListener('scroll', () => {
      nav?.classList.toggle('scrolled', window.scrollY > 60);
    }, { passive: true });

    // ── Mobile menu ──
    const mobileBtn  = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileBtn?.addEventListener('click', () => {
      const open = mobileMenu?.classList.toggle('hidden') === false;
      mobileBtn.setAttribute('aria-expanded', String(open));
    });
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => mobileMenu?.classList.add('hidden'));
    });

    // ── Scroll reveal ──
    const ro = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('visible'); ro.unobserve(e.target); }
      }),
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal').forEach(el => ro.observe(el));
  </script>

</body>
</html>
